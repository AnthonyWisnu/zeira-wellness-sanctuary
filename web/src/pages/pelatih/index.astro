---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import Icon from '../../components/Icon.astro';
import { actions } from 'astro:actions';
import { PelatihService } from '../../../services/pelatih/pelatih.service';

const user = Astro.locals.user;
if (!user || (user.peran !== 'pelatih' && user.peran !== 'admin')) {
  return Astro.redirect('/login?redirect=/pelatih');
}

const currentTab = Astro.url.searchParams.get('tab');
const selectedSesiId = Astro.url.searchParams.get('sesiId');

const actionResultVerif = Astro.getActionResult(actions.verifikasiKehadiran);
const actionResultSelesai = Astro.getActionResult(actions.selesaikanSesi);

const jadwalList = await PelatihService.getJadwalPelatih(user.id);

// Perhitungan metrik umum
const totalSesi = jadwalList.length;
const totalPesertaSemua = jadwalList.reduce((acc, s) => acc + (s.tb_reservasi_sesi?.length || 0), 0);
const selesaiCount = jadwalList.filter((s) => s.status_sesi === 'selesai').length;

// Menentukan mode tampilan
const isAttendanceMode = Boolean(selectedSesiId || currentTab === 'absensi');
const activeSesi = selectedSesiId
  ? jadwalList.find((s) => s.id === selectedSesiId)
  : (isAttendanceMode ? jadwalList[0] : null);

const pesertaActive = activeSesi?.tb_reservasi_sesi || [];
const hadirCount = pesertaActive.filter((p: any) => p.status_reservasi === 'hadir').length;
const mangkirCount = pesertaActive.filter((p: any) => p.status_reservasi === 'tidak_hadir').length;
const belumDiabsenCount = pesertaActive.filter((p: any) => p.status_reservasi === 'dipesan').length;

function formatJamMenit(d: Date | string): string {
  const date = typeof d === 'string' ? new Date(d) : d;
  return date.toLocaleTimeString('id-ID', {
    hour: '2-digit',
    minute: '2-digit',
    hour12: false,
    timeZone: 'Asia/Makassar',
  }).replace('.', ':');
}

function formatTanggalLengkap(d: Date | string): string {
  const date = typeof d === 'string' ? new Date(d) : d;
  return date.toLocaleDateString('id-ID', {
    weekday: 'long',
    day: 'numeric',
    month: 'long',
    year: 'numeric',
    timeZone: 'Asia/Makassar',
  });
}
---

<DashboardLayout title="Portal Instruktur" activeMenu="jadwal">
  <!-- NOTIFIKASI HASIL AKSI -->
  {(actionResultVerif?.error || actionResultSelesai?.error) && (
    <div class="feedback-banner feedback-banner--error">
      <Icon name="warning-circle" size="1.2rem" />
      <span>{actionResultVerif?.error?.message || actionResultSelesai?.error?.message}</span>
    </div>
  )}
  {(actionResultVerif?.data?.success || actionResultSelesai?.data?.success) && (
    <div class="feedback-banner feedback-banner--success">
      <Icon name="check-circle" size="1.2rem" />
      <span>Status kehadiran peserta berhasil diverifikasi secara instan.</span>
    </div>
  )}

  <!-- ========================================================================= -->
  <!-- MODE 1: LEMBAR PRESENSI FOKUS PER SESI KELAS                              -->
  <!-- ========================================================================= -->
  {isAttendanceMode && activeSesi ? (
    <div class="attendance-page">
      <!-- TOMBOL KEMBALI DISIPLIN -->
      <div class="back-nav-bar">
        <a href="/pelatih" class="btn-back">
          <Icon name="arrow-left" size="1.1rem" />
          <span>Kembali ke Jadwal Mengajar</span>
        </a>
      </div>

      <div class="page-header">
        <div class="page-eyebrow">PORTAL INSTRUKTUR • VERIFIKASI PRESENSI FISIK</div>
        <h1 class="page-title">Lembar Presensi Kelas</h1>
        <p class="page-subtitle">
          Verifikasi kehadiran fisik peserta di pintu studio secara real-time. Data tercatat sah di bawah nama instruktur.
        </p>
      </div>

      <!-- PAPAN INSPEKSI SESI (ATELIER SPEC CARD MEWAH) -->
      <div class="surface-card spec-card">
        <div class="spec-card__top">
          <div class="spec-card__tags">
            <span class="pill-tag pill-tag--brass">
              {activeSesi.tb_kategori_layanan.nama_kategori}
            </span>
            {activeSesi.status_sesi === 'selesai' ? (
              <span class="pill-tag pill-tag--green">KELAS TELAH SELESAI</span>
            ) : (
              <span class="pill-tag pill-tag--brass">
                SESI AKTIF
              </span>
            )}
          </div>

          <div>
            {activeSesi.status_sesi !== 'selesai' && (
              <form method="POST" action={actions.selesaikanSesi} onsubmit="return confirm('Tandai sesi kelas ini telah selesai?');" style="margin: 0;">
                <input type="hidden" name="jadwalId" value={activeSesi.id} />
                <button type="submit" class="btn-complete-session">
                  Selesaikan Kelas
                </button>
              </form>
            )}
          </div>
        </div>

        <h2 class="spec-card__title">{activeSesi.judul_sesi}</h2>

        <!-- GRID DETAIL SPESIFIKASI KELAS (DISIPLIN PER-ROW MUTLAK, ZERO INLINE BULLETS) -->
        <div class="spec-grid-box">
          <div class="spec-grid-item">
            <div class="spec-grid-item__label">TANGGAL KELAS</div>
            <div class="spec-grid-item__value spec-grid-item__value--bold">{formatTanggalLengkap(activeSesi.waktu_mulai)}</div>
          </div>

          <div class="spec-grid-item">
            <div class="spec-grid-item__label">JAM PELAKSANAAN</div>
            <div class="spec-grid-item__value spec-grid-item__value--bold">{formatJamMenit(activeSesi.waktu_mulai)} – {formatJamMenit(activeSesi.waktu_selesai)} WITA</div>
          </div>

          <div class="spec-grid-item">
            <div class="spec-grid-item__label">RUANGAN STUDIO</div>
            <div class="spec-grid-item__value spec-grid-item__value--bold">{activeSesi.tb_ruangan.nama_ruangan}</div>
          </div>

          <div class="spec-grid-item">
            <div class="spec-grid-item__label">LOKASI RUANGAN</div>
            <div class="spec-grid-item__value">{activeSesi.tb_ruangan.lokasi}</div>
          </div>

          <div class="spec-grid-item spec-grid-item--full">
            <div class="spec-grid-item__label">KUOTA STUDIO</div>
            <div class="spec-grid-item__value">
              <strong class="quota-highlight">{activeSesi.jumlah_terisi} / {activeSesi.kapasitas_maksimal}</strong> Kursi Terisi
              <span class="quota-note">({activeSesi.kapasitas_maksimal - activeSesi.jumlah_terisi} kursi tersisa)</span>
            </div>
          </div>
        </div>

        <!-- 4 TALLY METRIK KEHADIRAN SESI INI (4 KOTAK INLINE ATELIER KOKOH) -->
        <div class="tally-grid">
          <div class="tally-box">
            <div class="tally-box__label">TOTAL TERDAFTAR</div>
            <div class="tally-box__num">{pesertaActive.length}</div>
            <div class="tally-box__sub">Peserta Sah</div>
          </div>

          <div class="tally-box tally-box--green">
            <div class="tally-box__label">HADIR DI STUDIO</div>
            <div class="tally-box__num">{hadirCount}</div>
            <div class="tally-box__sub">Terverifikasi Fisik</div>
          </div>

          <div class="tally-box tally-box--red">
            <div class="tally-box__label">TIDAK HADIR (MANGKIR)</div>
            <div class="tally-box__num">{mangkirCount}</div>
            <div class="tally-box__sub">Tidak Datang</div>
          </div>

          <div class="tally-box tally-box--brass">
            <div class="tally-box__label">MENUNGGU ABSEN</div>
            <div class="tally-box__num">{belumDiabsenCount}</div>
            <div class="tally-box__sub">Di Pintu Studio</div>
          </div>
        </div>
      </div>

      <!-- LEMBAR TABEL DAFTAR PESERTA (ATELIER LEDGER TABLE MUTLAK, ZERO NUMPUK) -->
      <div class="surface-card ledger-card">
        <div class="ledger-header">
          <div class="ledger-header__title">
            DAFTAR PESERTA TERDAFTAR ({pesertaActive.length} ORANG)
          </div>
        </div>

        {pesertaActive.length === 0 ? (
          <div class="ledger-empty">
            <Icon name="ticket" size="2.5rem" style="color: var(--text-subtle); margin-bottom: 0.75rem;" />
            <div style="font-weight: 800; font-size: 1.05rem; color: var(--text-main); margin-bottom: 4px;">Belum Ada Peserta Terdaftar</div>
            <p style="font-size: 0.88rem; color: var(--text-muted); margin: 0;">
              Belum ada pelanggan yang memesan tiket sah untuk sesi kelas studio ini.
            </p>
          </div>
        ) : (
          <div class="table-responsive">
            <table class="attendance-table">
              <thead>
                <tr>
                  <th style="width: 48px; text-align: center;">NO</th>
                  <th>NAMA PESERTA</th>
                  <th>DETAIL TIKET & TARIF</th>
                  <th style="text-align: center; width: 190px;">STATUS KEHADIRAN</th>
                  <th style="text-align: center; width: 200px;">AKSI PRESENSI</th>
                </tr>
              </thead>
              <tbody>
                {pesertaActive.map((p: any, idx: number) => {
                  const isPresent = p.status_reservasi === 'hadir';
                  const isAbsent = p.status_reservasi === 'tidak_hadir';
                  const pelanggan = p.tb_pengguna || p.tb_pengguna_tb_reservasi_sesi_id_pelangganTotb_pengguna;
                  const namaPelanggan = pelanggan?.nama_lengkap || 'Peserta Terdaftar';
                  const emailPelanggan = pelanggan?.email || '';

                  return (
                    <tr>
                      <!-- COL 1: NO & AVATAR -->
                      <td style="text-align: center; vertical-align: middle;">
                        <div class="user-avatar-badge">{namaPelanggan.charAt(0)}</div>
                      </td>

                      <!-- COL 2: PESERTA INFO -->
                      <td style="vertical-align: middle;">
                        <div class="user-name-text">{idx + 1}. {namaPelanggan}</div>
                        {emailPelanggan && <div class="user-email-text">{emailPelanggan}</div>}
                      </td>

                      <!-- COL 3: TIKET & TARIF (PER-ROW JELAS) -->
                      <td style="vertical-align: middle;">
                        <div class="ticket-specs-block">
                          <div class="ticket-spec-line">
                            <span class="ticket-spec-label">TIKET:</span>
                            <span class="ticket-code-tag">{p.kode_reservasi}</span>
                          </div>
                          <div class="ticket-spec-line">
                            <span class="ticket-spec-label">TARIF:</span>
                            <span class={`tariff-tag ${p.tipe_tarif === 'member' ? 'tariff-tag--member' : 'tariff-tag--guest'}`}>
                              {p.tipe_tarif === 'member' ? 'Member Aktif' : 'Tamu Drop-in'}
                            </span>
                          </div>
                        </div>
                      </td>

                      <!-- COL 4: STATUS KEHADIRAN (KOLOM DEDIKASI SENDIRI, TIDAK NUMPUK!) -->
                      <td style="text-align: center; vertical-align: middle;">
                        {isPresent && (
                          <span class="status-badge status-badge--present">
                            ✓ HADIR FISIK
                          </span>
                        )}
                        {isAbsent && (
                          <span class="status-badge status-badge--absent">
                            ✗ TIDAK HADIR
                          </span>
                        )}
                        {p.status_reservasi === 'dipesan' && (
                          <span class="status-badge status-badge--pending">
                            ● MENUNGGU ABSEN
                          </span>
                        )}
                      </td>

                      <!-- COL 5: TOMBOL AKSI PRESENSI TACTILE SOLID -->
                      <td style="text-align: center; vertical-align: middle;">
                        <div class="attendance-actions-cell">
                          <form method="POST" action={actions.verifikasiKehadiran} style="margin: 0;">
                            <input type="hidden" name="reservasiId" value={p.id} />
                            <input type="hidden" name="status" value="hadir" />
                            <button
                              type="submit"
                              class={`btn-attendance btn-attendance--present ${isPresent ? 'btn-attendance--active' : ''}`}
                              title="Tandai Hadir di Studio"
                            >
                              ✓ Hadir
                            </button>
                          </form>

                          <form method="POST" action={actions.verifikasiKehadiran} style="margin: 0;">
                            <input type="hidden" name="reservasiId" value={p.id} />
                            <input type="hidden" name="status" value="tidak_hadir" />
                            <button
                              type="submit"
                              class={`btn-attendance btn-attendance--absent ${isAbsent ? 'btn-attendance--active' : ''}`}
                              title="Tandai Tidak Hadir (Mangkir)"
                            >
                              ✗ Mangkir
                            </button>
                          </form>
                        </div>
                      </td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
        )}
      </div>
    </div>
  ) : isAttendanceMode && !activeSesi ? (
    <div class="surface-card" style="padding: 3rem; text-align: center;">
      <Icon name="clipboard-text" size="2.5rem" style="color: var(--text-subtle); margin-bottom: 1rem;" />
      <h3 style="font-family: var(--font-display); font-size: 1.25rem; font-weight: 800; margin: 0 0 6px;">
        Sesi Kelas Tidak Ditemukan
      </h3>
      <p style="font-size: 0.88rem; color: var(--text-muted); margin: 0 0 1.5rem;">
        Sesi kelas yang Anda minta tidak terdaftar atau telah diarsipkan.
      </p>
      <a href="/pelatih" class="btn-primary" style="text-decoration: none; display: inline-flex; align-items: center; gap: 6px;">
        <Icon name="arrow-left" size="1.1rem" />
        <span>Kembali ke Jadwal Mengajar</span>
      </a>
    </div>
  ) : (
    <div>
      <div class="page-header">
        <div class="page-eyebrow">PORTAL INSTRUKTUR • AGENDA MENGAJAR</div>
        <h1 class="page-title">Jadwal Sesi Mengajar Anda</h1>
        <p class="page-subtitle">
          Pantau seluruh agenda kelas studio yang Anda bimbing, alokasi ruangan, dan kuota peserta.
        </p>
      </div>

      <!-- 4 KPI CARDS INSTRUKTUR -->
      <div class="kpi-grid">
        <div class="surface-card kpi-card">
          <div class="kpi-label">TOTAL SESI KELAS</div>
          <div class="kpi-value">{totalSesi}</div>
          <div class="kpi-subtext">Sesi terdaftar aktif</div>
        </div>

        <div class="surface-card kpi-card">
          <div class="kpi-label">TOTAL PESERTA DIAJAR</div>
          <div class="kpi-value">{totalPesertaSemua}</div>
          <div class="kpi-subtext">Tiket terkonfirmasi sah</div>
        </div>

        <div class="surface-card kpi-card">
          <div class="kpi-label">SESI DISELESAIKAN</div>
          <div class="kpi-value">{selesaiCount} / {totalSesi}</div>
          <div class="kpi-subtext">Kelas tuntas terlaksana</div>
        </div>

        <div class="surface-card kpi-card">
          <div class="kpi-label">STATUS PENUGASAN</div>
          <div class="kpi-value kpi-value--active">● Aktif Bertugas</div>
          <div class="kpi-subtext">Studio siap dipandu</div>
        </div>
      </div>

      <!-- DAFTAR KARTU JADWAL MENGAJAR -->
      <div class="section-heading">
        <h2 class="section-title">
          Daftar Sesi Mengajar ({jadwalList.length})
        </h2>
      </div>

      {jadwalList.length === 0 ? (
        <div class="surface-card" style="padding: 3rem; text-align: center;">
          <Icon name="calendar-check" size="2.5rem" style="color: var(--text-subtle); margin-bottom: 1rem;" />
          <h3 style="font-family: var(--font-display); font-size: 1.2rem; font-weight: 800; margin: 0 0 6px;">
            Tidak Ada Sesi Mengajar
          </h3>
          <p style="font-size: 0.88rem; color: var(--text-muted); margin: 0;">
            Anda belum memiliki jadwal mengajar aktif untuk saat ini.
          </p>
        </div>
      ) : (
        <div class="sesi-list">
          {jadwalList.map((sesi) => {
            const startDayStr = formatTanggalLengkap(sesi.waktu_mulai);
            const timeRangeStr = `${formatJamMenit(sesi.waktu_mulai)} – ${formatJamMenit(sesi.waktu_selesai)} WITA`;
            const pesertaCount = sesi.tb_reservasi_sesi?.length || 0;
            const isCompleted = sesi.status_sesi === 'selesai';
            const sisaKursi = sesi.kapasitas_maksimal - sesi.jumlah_terisi;

            return (
              <div class="sesi-item-card surface-card">
                <div class="sesi-item-card__main">
                  <div class="sesi-item-card__tags">
                    <span class="pill-tag pill-tag--brass">
                      {sesi.tb_kategori_layanan.nama_kategori}
                    </span>
                    {isCompleted ? (
                      <span class="pill-tag pill-tag--green">SELESAI</span>
                    ) : (
                      <span class="pill-tag pill-tag--brass">
                        TERJADWAL
                      </span>
                    )}
                  </div>

                  <h3 class="sesi-item-card__title">
                    {sesi.judul_sesi}
                  </h3>

                  <!-- PER-ROW STRUCTURED SPEC SHEET (DISIPLIN ZERO INLINE BULLETS) -->
                  <div class="sesi-spec-grid">
                    <div class="sesi-spec-row">
                      <div class="sesi-spec-key">TANGGAL SESI</div>
                      <div class="sesi-spec-val sesi-spec-val--strong">
                        {startDayStr}
                      </div>
                    </div>

                    <div class="sesi-spec-row">
                      <div class="sesi-spec-key">JAM PELAKSANAAN</div>
                      <div class="sesi-spec-val sesi-spec-val--strong">
                        {timeRangeStr}
                      </div>
                    </div>

                    <div class="sesi-spec-row">
                      <div class="sesi-spec-key">RUANGAN STUDIO</div>
                      <div class="sesi-spec-val sesi-spec-val--strong">
                        {sesi.tb_ruangan.nama_ruangan}
                      </div>
                    </div>

                    <div class="sesi-spec-row">
                      <div class="sesi-spec-key">LOKASI RUANGAN</div>
                      <div class="sesi-spec-val">
                        {sesi.tb_ruangan.lokasi}
                      </div>
                    </div>

                    <div class="sesi-spec-row">
                      <div class="sesi-spec-key">KUOTA KELAS</div>
                      <div class="sesi-spec-val">
                        <strong>{sesi.jumlah_terisi} / {sesi.kapasitas_maksimal}</strong> Kursi Terisi
                        <span class="sesi-spec-sub">({sisaKursi > 0 ? `${sisaKursi} kursi tersisa` : 'Penuh'})</span>
                      </div>
                    </div>
                  </div>
                </div>

                <!-- AKSI KELAS -->
                <div class="sesi-item-card__actions">
                  <a
                    href={`/pelatih?sesiId=${sesi.id}`}
                    class="btn-primary"
                    style="text-decoration: none; display: flex; align-items: center; justify-content: center; gap: 8px; width: 100%; white-space: nowrap;"
                  >
                    <Icon name="clipboard-text" size="1.1rem" />
                    <span>Buka Lembar Presensi ({pesertaCount})</span>
                  </a>

                  {!isCompleted && (
                    <form method="POST" action={actions.selesaikanSesi} onsubmit="return confirm('Tandai sesi kelas ini telah selesai?');" style="margin: 0; width: 100%;">
                      <input type="hidden" name="jadwalId" value={sesi.id} />
                      <button type="submit" class="btn-secondary" style="width: 100%; justify-content: center;" title="Tandai Kelas Selesai">
                        Selesaikan Kelas
                      </button>
                    </form>
                  )}
                </div>
              </div>
            );
          })}
        </div>
      )}
    </div>
  )}
</DashboardLayout>

<style>
  /* BREADCRUMB & BACK BUTTON */
  .back-nav-bar {
    margin-bottom: 1.25rem;
  }
  .btn-back {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-body);
    font-size: 0.85rem;
    font-weight: 800;
    color: var(--color-primary);
    background: #FAF8F5;
    border: 1.5px solid var(--border-hairline);
    padding: 8px 16px;
    border-radius: var(--radius-sm);
    text-decoration: none;
    transition: all 0.15s ease;
  }
  .btn-back:hover {
    background: #F4EFEA;
    border-color: var(--color-brass);
    color: var(--color-primary-dark);
  }

  /* HEADERS (PLUS JAKARTA SANS SOLID WAJIB) */
  .page-header {
    margin-bottom: 1.75rem;
  }
  .page-eyebrow {
    font-family: var(--font-body);
    font-size: 0.78rem;
    color: var(--color-primary);
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .page-title {
    font-family: var(--font-display);
    font-size: 1.95rem;
    font-weight: 800;
    color: var(--text-main);
    margin: 4px 0 6px;
  }
  .page-subtitle {
    font-family: var(--font-body);
    font-size: 0.92rem;
    color: var(--text-muted);
    margin: 0;
    max-width: 680px;
    line-height: 1.55;
  }

  /* FEEDBACK NOTIFICATION */
  .feedback-banner {
    padding: 12px 16px;
    border-radius: var(--radius-md);
    font-size: 0.88rem;
    font-weight: 700;
    margin-bottom: 1.5rem;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .feedback-banner--error {
    background: #FCE8E6;
    border: 1.5px solid #C5221F;
    color: #900B09;
  }
  .feedback-banner--success {
    background: #E6F4EA;
    border: 1.5px solid #137333;
    color: #0D522C;
  }

  /* KPI CARDS */
  .kpi-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1rem;
    margin-bottom: 2rem;
  }
  .kpi-card {
    padding: 1.35rem;
  }
  .kpi-label {
    font-family: var(--font-body);
    font-size: 0.76rem;
    color: var(--text-muted);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .kpi-value {
    font-family: var(--font-display);
    font-size: 1.95rem;
    font-weight: 800;
    color: var(--color-primary);
    margin: 6px 0 2px;
  }
  .kpi-value--active {
    font-size: 1.15rem;
    color: #1B5E20;
    margin: 10px 0 4px;
  }
  .kpi-subtext {
    font-family: var(--font-body);
    font-size: 0.78rem;
    color: var(--text-subtle);
  }

  /* SECTION HEADING */
  .section-heading {
    margin-bottom: 1.25rem;
  }
  .section-title {
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 800;
    margin: 0;
    color: var(--text-main);
  }

  /* SESI LIST & CARDS */
  .sesi-list {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .sesi-item-card {
    padding: 1.5rem 1.75rem;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 1.5rem;
  }
