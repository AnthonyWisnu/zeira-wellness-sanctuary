---
import SanctuaryLayout from '../../layouts/SanctuaryLayout.astro';
import Icon from '../../components/Icon.astro';
import { actions } from 'astro:actions';

const user = Astro.locals.user;
if (user) {
  return Astro.redirect('/riwayat');
}

const result = Astro.getActionResult(actions.register);
if (result && !result.error && result.data?.success) {
  return Astro.redirect('/riwayat');
}
---

<SanctuaryLayout title="Daftar Akun — ZEIRA Wellness Sanctuary">
  <main class="page-container" style="padding: 4rem 0 6rem;">
    <div class="container" style="max-width: 520px;">
      
      <div class="surface-card" style="padding: 2.25rem;">
        <div style="text-align: center; margin-bottom: 2rem;">
          <div style="font-family: var(--font-mono); font-size: 0.72rem; color: var(--color-primary); font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; margin-bottom: 6px;">
            KEANGGOTAAN SANCTUARY
          </div>
          <h1 style="font-family: var(--font-display); font-size: 1.8rem; font-weight: 800; color: var(--text-main); margin: 0 0 8px;">
            Pendaftaran Tamu Baru
          </h1>
          <p style="font-size: 0.88rem; color: var(--text-muted); margin: 0;">
            Buat akun untuk memesan sesi studio atau berlangganan membership privat.
          </p>
        </div>

        {result?.error && (
          <div style="background: #FDEDED; border: 1px solid #F5C6CB; color: #721C24; padding: 12px 16px; border-radius: var(--radius-md); font-size: 0.85rem; margin-bottom: 1.5rem; display: flex; align-items: center; gap: 8px;">
            <Icon name="warning-circle" size="1.2rem" />
            <span>{result.error.message}</span>
          </div>
        )}

        <form method="POST" action={actions.register} style="display: flex; flex-direction: column; gap: 1.2rem;">
          <div>
            <label for="namaLengkap" style="display: block; font-size: 0.8rem; font-weight: 700; margin-bottom: 6px; color: var(--text-main);">
              Nama Lengkap
            </label>
            <input
              type="text"
              id="namaLengkap"
              name="namaLengkap"
              required
              placeholder="Contoh: Anthony Wisnu"
              style="width: 100%; padding: 10px 14px; border: 1px solid var(--border-hairline); border-radius: var(--radius-md); font-family: var(--font-body); font-size: 0.9rem; background: #FAF8F5;"
            />
          </div>

          <div>
            <label for="email" style="display: block; font-size: 0.8rem; font-weight: 700; margin-bottom: 6px; color: var(--text-main);">
              Alamat Email
            </label>
            <input
              type="email"
              id="email"
              name="email"
              required
              placeholder="nama@domain.com"
              style="width: 100%; padding: 10px 14px; border: 1px solid var(--border-hairline); border-radius: var(--radius-md); font-family: var(--font-body); font-size: 0.9rem; background: #FAF8F5;"
            />
          </div>

          <div>
            <label for="nomorTelepon" style="display: block; font-size: 0.8rem; font-weight: 700; margin-bottom: 6px; color: var(--text-main);">
              Nomor WhatsApp / Telepon (Opsional)
            </label>
            <input
              type="tel"
              id="nomorTelepon"
              name="nomorTelepon"
              placeholder="+62 812-3456-7890"
              style="width: 100%; padding: 10px 14px; border: 1px solid var(--border-hairline); border-radius: var(--radius-md); font-family: var(--font-body); font-size: 0.9rem; background: #FAF8F5;"
            />
          </div>

          <div>
            <label for="kataSandi" style="display: block; font-size: 0.8rem; font-weight: 700; margin-bottom: 6px; color: var(--text-main);">
              Kata Sandi (Minimal 6 Karakter)
            </label>
            <input
              type="password"
              id="kataSandi"
              name="kataSandi"
              required
              placeholder="••••••••"
              style="width: 100%; padding: 10px 14px; border: 1px solid var(--border-hairline); border-radius: var(--radius-md); font-family: var(--font-body); font-size: 0.9rem; background: #FAF8F5;"
            />
          </div>

          <button type="submit" class="btn-primary" style="width: 100%; padding: 12px; margin-top: 0.5rem; font-size: 0.95rem;">
            Daftar Akun Sanctuary
          </button>
        </form>

        <div style="margin-top: 1.5rem; text-align: center; font-size: 0.85rem; color: var(--text-muted);">
          Sudah memiliki akun? <a href="/login" style="color: var(--color-primary); font-weight: 700; text-decoration: underline;">Masuk di sini</a>
        </div>

      </div>

    </div>
  </main>
</SanctuaryLayout>
