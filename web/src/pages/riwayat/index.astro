---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import Icon from '../../components/Icon.astro';
import { actions } from 'astro:actions';
import { ReservasiService } from '../../../services/reservasi/reservasi.service';

const user = Astro.locals.user;
if (!user) {
  return Astro.redirect('/login?redirect=/riwayat');
}

const actionResult = Astro.getActionResult(actions.batalkanReservasi);
const tiketList = await ReservasiService.getRiwayatTiketPelanggan(user.id);
const currentTab = Astro.url.searchParams.get('tab') || 'tiket';

const formatJamMenit = (dateVal: Date | string) => {
  const d = typeof dateVal === 'string' ? new Date(dateVal) : dateVal;
  return d.toLocaleTimeString('id-ID', {
    hour: '2-digit',
    minute: '2-digit',
    hour12: false,
    timeZone: 'Asia/Makassar',
  }).replace('.', ':');
};
---

<DashboardLayout title="Tiket & Keanggotaan Saya" activeMenu={currentTab}>
  {user.peran === 'admin' && (
    <div style="background: #EBF3FF; border: 1px solid #B8D5FA; color: #1E4E8C; padding: 12px 18px; border-radius: var(--radius-md); font-size: 0.86rem; margin-bottom: 2rem; display: flex; justify-content: space-between; align-items: center; gap: 12px;">
      <div style="display: flex; align-items: center; gap: 10px;">
        <Icon name="shield-check" size="1.25rem" />
        <span>Anda sedang masuk sebagai <strong>System Administrator ({user.nama_lengkap})</strong>. Halaman ini adalah portal pelanggan.</span>
      </div>
      <a href="/admin" class="btn-primary" style="padding: 6px 14px; font-size: 0.8rem; text-decoration: none; white-space: nowrap;">
        Buka Dashboard Admin &rarr;
      </a>
    </div>
  )}

  <!-- NOTIFIKASI AKSI -->
  {actionResult?.error && (
    <div style="background: #FDEDED; border: 1px solid #F5C6CB; color: #721C24; padding: 12px 16px; border-radius: var(--radius-md); font-size: 0.85rem; margin-bottom: 1.5rem; display: flex; align-items: center; gap: 8px;">
      <Icon name="warning-circle" size="1.2rem" />
      <span>{actionResult.error.message}</span>
    </div>
  )}
  {actionResult?.data?.success && (
    <div style="background: #EDF7EE; border: 1px solid #C8E6C9; color: #1B5E20; padding: 12px 16px; border-radius: var(--radius-md); font-size: 0.85rem; margin-bottom: 1.5rem; display: flex; align-items: center; gap: 8px;">
      <Icon name="check-circle" size="1.2rem" />
      <span>{actionResult.data.message || 'Aksi berhasil diproses.'}</span>
    </div>
  )}

  <!-- VIEW 1: STATUS MEMBERSHIP & DEDICATED LOCKER -->
  {currentTab === 'membership' && (
    <div>
      <div class="schedule-header-bar" style="margin-bottom: 2rem;">
        <h1 class="schedule-header-bar__title">Status Membership & Loker Pribadi</h1>
        <div class="schedule-stat-chip">
          <span class="schedule-stat-chip__label">STATUS AKUN:</span>
          <span class="schedule-stat-chip__value">{user.isMemberAktif ? 'Member Aktif' : 'Tamu Umum'}</span>
        </div>
      </div>

      {user.isMemberAktif && user.keanggotaanAktif ? (
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.75rem;">
          <!-- KARTU STATUS MEMBER -->
          <div class="surface-card" style="padding: 1.75rem; border: 1.5px solid var(--color-brass);">
            <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 1.25rem;">
              <div>
                <span class="pill-tag pill-tag--brass" style="font-size: 0.72rem; margin-bottom: 6px;">
                  MEMBER RESMI AKTIF
                </span>
                <h3 style="font-family: var(--font-display); font-size: 1.4rem; font-weight: 800; color: var(--text-main); margin: 0;">
                  {user.keanggotaanAktif.nama_paket}
                </h3>
              </div>
              <div style="width: 42px; height: 42px; border-radius: 50%; background: var(--color-brass-bg); border: 1px solid var(--color-brass); display: flex; align-items: center; justify-content: center; color: var(--color-brass-dark);">
                <Icon name="crown" size="1.4rem" />
              </div>
            </div>

            <div style="background: #FFF; border: 1px solid var(--border-hairline); border-radius: var(--radius-sm); padding: 12px 14px; margin-bottom: 1.25rem;">
              <div style="font-size: 0.75rem; color: var(--text-muted); margin-bottom: 2px;">Masa Berlaku Keanggotaan:</div>
              <div style="font-family: var(--font-body); font-variant-numeric: tabular-nums; font-size: 0.95rem; font-weight: 800; color: var(--color-primary);">
                Aktif s/d {user.keanggotaanAktif.tanggal_berakhir}
              </div>
            </div>

            <div style="font-size: 0.82rem; color: var(--text-main); font-weight: 700; margin-bottom: 8px;">
              Hak Istimewa yang Anda Miliki:
            </div>
            <ul style="margin: 0; padding-left: 1.2rem; font-size: 0.82rem; color: var(--text-muted); line-height: 1.6;">
              <li>Akses bebas Hydro Mineral Pool (34°C) & Herbal Sauna harian.</li>
              <li>Priority Vision Window: Hak reservasi jadwal hingga <strong>30 hari ke depan</strong>.</li>
              <li>Tarif hemat sesi kelas studio (diskon hingga 50%).</li>
              <li>Complimentary herbal hydration bar harian.</li>
            </ul>
          </div>

          <!-- KARTU DEDICATED LOCKER RFID -->
          <div class="surface-card" style="padding: 1.75rem; border: 1.5px solid var(--color-primary);">
            <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 1.25rem;">
              <div>
                <span class="pill-tag pill-tag--green" style="font-size: 0.72rem; margin-bottom: 6px;">
                  DEDICATED LOCKER READY
                </span>
                <h3 style="font-family: var(--font-display); font-size: 1.4rem; font-weight: 800; color: var(--text-main); margin: 0;">
                  Lemari Loker Pribadi Anda
                </h3>
              </div>
              <div style="width: 42px; height: 42px; border-radius: 50%; background: #EDF7EE; border: 1px solid #C8E6C9; display: flex; align-items: center; justify-content: center; color: #1B5E20;">
                <Icon name="lock-key" size="1.4rem" />
              </div>
            </div>

            <div style="background: #FAF8F5; border: 1px dashed var(--color-primary); border-radius: var(--radius-sm); padding: 14px; text-align: center; margin-bottom: 1.25rem;">
              <div style="font-size: 0.74rem; font-family: var(--font-body); font-weight: 800; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.04em;">
                KODE LEMARI LOKER FISIK
              </div>
              <div style="font-family: var(--font-body); font-variant-numeric: tabular-nums; font-size: 2.4rem; font-weight: 800; color: var(--color-primary); letter-spacing: 0.05em; margin: 4px 0;">
                {user.keanggotaanAktif.nomor_loker || 'LK-02'}
              </div>
              <div style="font-size: 0.78rem; color: var(--text-muted);">
                Lokasi: <strong>Locker Room Pria — Sayap Timur</strong>
              </div>
            </div>

            <div style="font-size: 0.82rem; color: var(--text-muted); line-height: 1.5;">
              Loker ini telah dialokasikan khusus untuk Anda. Anda dapat menggunakan kartu RFID digital pada aplikasi atau scan gelang fisik saat tiba di resepsionis.
            </div>
          </div>
        </div>
      ) : (
        <div class="surface-card" style="padding: 2.5rem; text-align: center; max-width: 600px; margin: 0 auto;">
          <div style="width: 54px; height: 54px; border-radius: 50%; background: var(--color-brass-bg); border: 1px solid var(--color-brass); display: flex; align-items: center; justify-content: center; color: var(--color-brass-dark); margin: 0 auto 1.25rem;">
            <Icon name="lock-key" size="1.8rem" />
          </div>
          <span class="pill-tag pill-tag--brass" style="font-size: 0.75rem; margin-bottom: 8px;">
            STATUS: TAMU UMUM (DROP-IN PASS)
          </span>
          <h2 style="font-family: var(--font-display); font-size: 1.6rem; font-weight: 800; color: var(--text-main); margin: 6px 0 8px;">
            Anda Belum Memiliki Loker Pribadi
          </h2>
          <p style="font-size: 0.88rem; color: var(--text-muted); line-height: 1.6; margin-bottom: 1.75rem;">
            Sebagai tamu drop-in, Anda dapat memesan sesi kelas studio dengan tarif reguler dan jendela jadwal 7 hari. Tingkatkan ke Membership untuk mendapatkan <strong>1 Dedicated Locker Tetap</strong>, akses bebas kolam hydro harian, dan tarif diskon hingga 50%!
          </p>
          <a href="/membership" class="btn-primary" style="padding: 12px 24px; text-decoration: none; font-size: 0.95rem;">
            Pilih Paket Membership & Loker &rarr;
          </a>
        </div>
      )}
    </div>
  )}

  <!-- VIEW 2: TIKET RESERVASI KELAS (DEFAULT) -->
  {currentTab === 'tiket' && (
    <div>
      <div class="schedule-header-bar" style="margin-bottom: 2rem;">
        <div style="display: flex; align-items: center; gap: 1rem; flex-wrap: wrap;">
          <h1 class="schedule-header-bar__title">Tiket Reservasi Kelas</h1>
          <div class="schedule-stat-chip">
            <span class="schedule-stat-chip__label">TOTAL TIKET:</span>
            <span class="schedule-stat-chip__value">{tiketList.length} Terdaftar</span>
          </div>
        </div>

        <div>
          <a href="/jadwal" class="btn-primary" style="text-decoration: none; font-size: 0.85rem; padding: 9px 16px; display: inline-flex; align-items: center; gap: 6px;">
            <Icon name="calendar-check" size="1rem" /> + Pesan Kelas Studio
          </a>
        </div>
      </div>

      {tiketList.length === 0 ? (
        <div class="surface-card" style="padding: 3rem; text-align: center;">
          <Icon name="ticket" size="2.5rem" style="color: var(--text-subtle); margin-bottom: 1rem;" />
          <h3 style="font-family: var(--font-display); font-size: 1.2rem; font-weight: 800; margin: 0 0 6px;">
            Belum Ada Tiket Kelas
          </h3>
          <p style="font-size: 0.88rem; color: var(--text-muted); max-width: 420px; margin: 0 auto 1.5rem;">
            Anda belum memesan sesi studio. Silakan jelajahi jadwal kelas yoga, reformer pilates, atau sound healing yang tersedia.
          </p>
          <a href="/jadwal" class="btn-primary" style="padding: 10px 20px; text-decoration: none;">
            Lihat Jadwal Kelas Studio
          </a>
        </div>
      ) : (
        <div style="display: flex; flex-direction: column; gap: 1.25rem;">
          {tiketList.map((t) => {
            const isConfirmed = t.status_reservasi === 'dipesan';
            const isAttended = t.status_reservasi === 'hadir';
            const isCancelled = t.status_reservasi === 'dibatalkan' || t.status_reservasi === 'kedaluwarsa';
            const isPending = t.status_reservasi === 'menunggu_pembayaran';

            const startStr = new Date(t.waktu_mulai).toLocaleDateString('id-ID', {
              weekday: 'long',
              day: 'numeric',
              month: 'long',
              year: 'numeric',
              timeZone: 'Asia/Makassar',
            });
            const jamStr = `${formatJamMenit(t.waktu_mulai)} – ${formatJamMenit(t.waktu_selesai)} WITA`;

            return (
              <div class="ticket-card surface-card">
                <!-- TOP BAR: BADGE KODE TIKET, GENRE TEGAS & HARGA -->
                <div class="ticket-card__top">
                  <div class="ticket-card__tags">
                    <span class="ticket-code-badge" title="Kode Reservasi Unik">
                      {t.kode_reservasi}
                    </span>
                    <span class="pill-tag pill-tag--brass ticket-genre-badge">
                      {t.kategori}
                    </span>
                  </div>

                  <div class="ticket-card__price-box">
                    <div class="ticket-price">
                      Rp {t.harga_dikenakan.toLocaleString('id-ID')}
                    </div>
                    <span class={`ticket-rate-label ${t.tipe_tarif === 'member' ? 'ticket-rate-label--member' : ''}`}>
                      {t.tipe_tarif === 'member' ? 'TARIF MEMBER' : 'TARIF REGULER'}
                    </span>
                  </div>
                </div>

                <!-- JUDUL KELAS STUDIO -->
                <h3 class="ticket-card__title">
                  {t.judul_sesi}
                </h3>

                <!-- SPEC PANEL: TIAP DATA SATU BARIS BERSIH (ZERO BULLET / NO SIMBOL ANEH) -->
                <div class="ticket-specs-panel">
                  <!-- BARIS 1: WAKTU & JAM -->
                  <div class="ticket-spec-row">
                    <div class="ticket-spec-field">
                      <span class="ticket-spec-icon"><Icon name="clock" size="1.05rem" /></span>
                      <span class="ticket-spec-label">Waktu Sesi:</span>
                    </div>
                    <div class="ticket-spec-value">
                      <span class="ticket-date-text">{startStr}</span>
                      <span class="ticket-time-badge">{jamStr}</span>
                    </div>
                  </div>

                  <!-- BARIS 2: RUANGAN STUDIO -->
                  <div class="ticket-spec-row">
                    <div class="ticket-spec-field">
                      <span class="ticket-spec-icon"><Icon name="door" size="1.05rem" /></span>
                      <span class="ticket-spec-label">Ruangan:</span>
                    </div>
                    <div class="ticket-spec-value">
                      <strong class="ticket-room-name">{t.ruangan}</strong>
                    </div>
                  </div>

                  <!-- BARIS 3: INSTRUKTUR -->
                  <div class="ticket-spec-row">
                    <div class="ticket-spec-field">
                      <span class="ticket-spec-icon"><Icon name="user" size="1.05rem" /></span>
                      <span class="ticket-spec-label">Instruktur:</span>
                    </div>
                    <div class="ticket-spec-value">
                      <strong class="ticket-trainer-name">{t.instruktur}</strong>
                    </div>
                  </div>
                </div>

                <!-- FOOTER KARTU: STATUS & AKSI -->
                <div class="ticket-card__footer">
                  <div class="ticket-footer-left">
                    {isConfirmed && <span class="pill-tag pill-tag--green">TIKET SAH (TERPESAN)</span>}
                    {isAttended && <span class="pill-tag pill-tag--green">SUDAH HADIR DI STUDIO</span>}
                    {isPending && <span class="pill-tag pill-tag--brass">MENUNGGU PEMBAYARAN (15M)</span>}
                    {isCancelled && <span class="pill-tag pill-tag--cancelled">DIBATALKAN</span>}

                    {isConfirmed && (
                      <span class="ticket-cancel-policy">
                        Batas pembatalan mandiri: <strong>{t.batas_batal_jam} jam</strong> sebelum sesi.
                      </span>
                    )}
                    {isAttended && (
                      <span class="ticket-cancel-policy">
                        Kehadiran Anda telah diverifikasi oleh pelatih di pintu studio.
                      </span>
                    )}
                  </div>

                  {t.canCancel && (
                    <form method="POST" action={actions.batalkanReservasi} onsubmit="return confirm('Apakah Anda yakin ingin membatalkan tiket reservasi ini? Kursi Anda akan dikembalikan ke publik.');" style="margin: 0;">
                      <input type="hidden" name="reservasiId" value={t.id} />
                      <button
                        type="submit"
                        class="ticket-cancel-btn"
                        title="Batalkan tiket sebelum batas waktu berakhir"
                      >
                        Batalkan Reservasi Mandiri
                      </button>
                    </form>
                  )}
                </div>
              </div>
            );
          })}
        </div>
      )}
    </div>
  )}

</DashboardLayout>

<style is:global>
  /* TICKET CARD STYLING */
  .ticket-card {
    padding: 1.5rem 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 1.15rem;
    background: #FAF8F5;
    border: 1px solid var(--border-hairline);
    border-radius: var(--radius-md);
    box-shadow: 0 2px 8px rgba(28, 48, 36, 0.04);
    transition: all 0.2s ease;
  }

  .ticket-card:hover {
    border-color: rgba(28, 48, 36, 0.25);
    box-shadow: 0 4px 14px rgba(28, 48, 36, 0.07);
  }

  .ticket-card__top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
  }

  .ticket-card__tags {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }

  .ticket-code-badge {
    font-family: var(--font-body);
    font-variant-numeric: tabular-nums;
    font-size: 0.76rem;
    font-weight: 800;
    color: var(--color-primary);
    background: #FFFFFF;
    border: 1.5px solid rgba(28, 48, 36, 0.18);
    padding: 4px 10px;
    border-radius: var(--radius-sm);
    letter-spacing: 0.06em;
  }

  .ticket-genre-badge {
    font-family: var(--font-body);
    font-size: 0.74rem;
    font-weight: 800;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    padding: 4px 10px;
  }

  .ticket-card__price-box {
    text-align: right;
    flex-shrink: 0;
  }

  .ticket-price {
    font-family: var(--font-body);
    font-variant-numeric: tabular-nums;
    font-size: 1.35rem;
    font-weight: 800;
    color: var(--color-primary);
    line-height: 1.1;
  }

  .ticket-rate-label {
    display: inline-block;
    font-family: var(--font-body);
    font-variant-numeric: tabular-nums;
    font-size: 0.68rem;
    font-weight: 700;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-top: 3px;
  }

  .ticket-rate-label--member {
    color: var(--color-brass-dark);
    font-weight: 800;
  }

  .ticket-card__title {
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 800;
    color: var(--text-main);
    margin: 0;
    line-height: 1.3;
  }

  /* SPECS PANEL PER-ROW */
  .ticket-specs-panel {
    background: #FFFFFF;
    border: 1px solid var(--border-hairline);
    border-radius: var(--radius-sm);
    padding: 1rem 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .ticket-spec-row {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px dashed rgba(28, 48, 36, 0.08);
  }

  .ticket-spec-row:last-child {
    padding-bottom: 0;
    border-bottom: none;
  }

  .ticket-spec-field {
    display: flex;
    align-items: center;
    gap: 8px;
    width: 140px;
    min-width: 140px;
  }

  .ticket-spec-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-primary);
  }

  .ticket-spec-label {
    font-family: var(--font-body);
    font-size: 0.72rem;
    font-weight: 800;
    color: var(--text-muted);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .ticket-spec-value {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
    color: var(--text-main);
    font-size: 0.9rem;
  }

  .ticket-date-text {
    font-weight: 700;
    color: var(--text-main);
  }

  .ticket-time-badge {
    font-family: var(--font-body);
    font-variant-numeric: tabular-nums;
    font-size: 0.8rem;
    font-weight: 800;
    color: var(--color-primary);
    background: #FAF8F5;
    border: 1px solid rgba(28, 48, 36, 0.16);
    padding: 2px 8px;
    border-radius: 4px;
    letter-spacing: 0.02em;
  }

  .ticket-room-name {
    font-weight: 700;
    color: var(--text-main);
  }

  .ticket-trainer-name {
    font-weight: 700;
    color: var(--text-main);
  }

  /* FOOTER */
  .ticket-card__footer {
    border-top: 1px dashed var(--border-hairline);
    padding-top: 1rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .ticket-footer-left {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
  }

  .pill-tag--cancelled {
    font-family: var(--font-body);
    font-variant-numeric: tabular-nums;
    font-size: 0.72rem;
    font-weight: 800;
    color: #721C24;
    background: #FDEDED;
    border: 1px solid #F5C6CB;
    padding: 3px 8px;
    border-radius: var(--radius-sm);
  }

  .ticket-cancel-policy {
    font-size: 0.76rem;
    color: var(--text-muted);
  }

  .ticket-cancel-btn {
    background: #FDEDED;
    color: #721C24;
    border: 1.5px solid #F5C6CB;
    padding: 7px 14px;
    font-size: 0.76rem;
    font-weight: 800;
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition: all 0.15s ease;
    font-family: var(--font-body);
  }

  .ticket-cancel-btn:hover {
    background: #F8D7DA;
    border-color: #D32F2F;
    color: #491217;
  }

  @media (max-width: 640px) {
    .ticket-spec-row {
      flex-direction: column;
      align-items: flex-start;
      gap: 4px;
    }
    .ticket-spec-field {
      width: auto;
      min-width: auto;
    }
  }
</style>
