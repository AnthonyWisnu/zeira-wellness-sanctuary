---
import SanctuaryLayout from '../../layouts/SanctuaryLayout.astro';
import Icon from '../../components/Icon.astro';
import { JadwalService } from '../../../services/jadwal/jadwal.service';

const user = Astro.locals.user;
const isMemberAktif = !!user?.isMemberAktif;
const kategoriSlug = Astro.url.searchParams.get('kategori') || 'semua';

const { jadwal, kategoriList } = await JadwalService.getKatalogJadwal(isMemberAktif, kategoriSlug);
---

<SanctuaryLayout
  title="Jadwal Kelas & Sesi Studio — ZEIRA SANCTUARY"
  description="Pilih tanggal dan amankan kursi studio Anda secara berurutan. Sistem mekanis anti-overbooking mengunci kursi Anda selama 15 menit secara real-time."
>
  <main class="container">
    <!-- PAGE HEADER -->
    <section class="schedule-page-header">
      <h1 class="section-heading" style="font-size: 2.4rem;">Jadwal Kelas & Sesi Studio</h1>

      <!-- FILTER BAR KATEGORI -->
      <div class="filter-bar" style="margin-top: 1.5rem;">
        <div class="filter-chips">
          <a href="/jadwal?kategori=semua" class={`chip ${kategoriSlug === 'semua' ? 'chip--active' : ''}`} style="text-decoration: none;">
            Semua Sesi
          </a>
          {kategoriList.map((k) => (
            <a
              href={`/jadwal?kategori=${k.slug}`}
              class={`chip ${kategoriSlug === k.slug ? 'chip--active' : ''}`}
              style="text-decoration: none;"
            >
              {k.nama_kategori}
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- VERTICAL CLASS CARDS LIST DARI DATABASE -->
    <section class="class-list" style="margin-top: 1.5rem;">
      {jadwal.length === 0 ? (
        <div class="surface-card" style="padding: 4rem; text-align: center;">
          <Icon name="calendar-blank" size="3rem" style="color: var(--text-subtle); margin-bottom: 1rem;" />
          <h3 style="font-family: var(--font-display); font-size: 1.3rem; font-weight: 800; margin: 0 0 8px;">
            Belum Ada Jadwal untuk Kategori Ini
          </h3>
          <p style="font-size: 0.9rem; color: var(--text-muted); margin: 0 auto 1.5rem; max-width: 420px;">
            Silakan pilih kategori kelas lain atau kembali untuk melihat seluruh sesi studio yang tersedia.
          </p>
          <a href="/jadwal?kategori=semua" class="btn-primary" style="padding: 10px 20px;">
            Tampilkan Semua Sesi
          </a>
        </div>
      ) : (
        jadwal.map((sesi) => {
          const startStr = new Date(sesi.waktu_mulai).toLocaleDateString('id-ID', {
            weekday: 'long',
            day: 'numeric',
            month: 'short',
          });
          const pct = Math.round((sesi.jumlah_terisi / sesi.kapasitas_maksimal) * 100);

          return (
            <div class="surface-card class-card" style={sesi.status_kuota === 'HAMPIR_PENUH' ? 'border-color: #DFB876;' : ''}>
              
              <!-- COL 1: WAKTU & STUDIO -->
              <div class="class-col-time">
                <div class="class-time-tag" style={sesi.status_kuota === 'HAMPIR_PENUH' ? 'color: #B25900;' : ''}>
                  {startStr}
                </div>
                <div class="class-time-val">
                  {new Date(sesi.waktu_mulai).toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit' })}
                  <span style="font-size: 0.8rem; font-weight: 500; color: var(--text-muted);">
                    – {new Date(sesi.waktu_selesai).toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit' })}
                  </span>
                </div>
                <div class="class-time-sub">Durasi ~75 Menit</div>
                <div class="class-venue-meta">
                  <div class="class-venue-room">
                    <Icon name="house-line" size={14} />
                    <span>{sesi.ruangan.nama}</span>
                  </div>
                  <div class="class-venue-floor">{sesi.ruangan.lokasi}</div>
                </div>
              </div>

              <!-- COL 2: JUDUL, INSTRUKTUR & KUOTA -->
              <div class="class-col-main">
                <div>
                  <div class="class-title-row">
                    <span class="pill-tag pill-tag--green">{sesi.kategori.nama}</span>
                  </div>
                  <h3 class="class-title" style="margin-top: 6px;">{sesi.judul_sesi}</h3>
                </div>

                <div class="class-instructor-row">
                  <div class="trainer-avatar-sm">
                    {sesi.pelatih.nama.charAt(0)}
                  </div>
                  <div class="trainer-info-sm">
                    <span class="trainer-label-sm">Instruktur:</span>
                    <span class="trainer-name-sm">{sesi.pelatih.nama}</span>
                    <span class="trainer-dot">•</span>
                    <span class="trainer-spec-sm">{sesi.pelatih.spesialisasi || 'Master Instructor'}</span>
                  </div>
                </div>

                <div class="class-cancel-hint">
                  Batas pembatalan mandiri: {sesi.batas_batal_jam} jam sebelum kelas dimulai
                </div>

                <div class="seat-meter">
                  <div class="seat-meter-header">
                    <span style={sesi.status_kuota === 'HAMPIR_PENUH' ? 'color: #B25900; font-weight: 700;' : 'color: var(--color-primary);'}>
                      {sesi.sisa_kuota === 0 ? '● Sesi Penuh / Habis' : `● Sisa ${sesi.sisa_kuota} dari ${sesi.kapasitas_maksimal} Kursi`}
                    </span>
                    <span style="color: var(--text-subtle);">{pct}% Terisi</span>
                  </div>
                  <div class="seat-progress-track">
                    <div
                      class={`seat-progress-fill ${sesi.status_kuota === 'HAMPIR_PENUH' ? 'seat-progress-fill--amber' : ''}`}
                      style={`width: ${pct}%;`}
                    ></div>
                  </div>
                </div>
              </div>

              <!-- COL 3: TARIF & ACTION CTA -->
              <div class="class-col-action">
                <div class="class-pricing-row">
                  {isMemberAktif ? (
                    <div>
                      <span class="member-free-tag">TARIF MEMBER AKTIF</span>
                      <div class="class-price-val">
                        {sesi.harga_member === 0 ? 'GRATIS' : `Rp ${sesi.harga_member.toLocaleString('id-ID')}`}
                        <span class="class-price-unit">/sesi</span>
                      </div>
                    </div>
                  ) : (
                    <div>
                      <div class="member-perk-hint">
                        MEMBER: Rp {sesi.harga_member.toLocaleString('id-ID')}
                      </div>
                      <div class="class-price-val">
                        Rp {sesi.harga_non_member.toLocaleString('id-ID')}
                        <span class="class-price-unit">/tamu</span>
                      </div>
                    </div>
                  )}
                </div>

                <div class="class-action-bottom">
                  {sesi.isLockedForGuest ? (
                    <div style="background: #FAF8F5; border: 1px dashed var(--border-hairline); border-radius: var(--radius-sm); padding: 8px 12px; text-align: center; width: 100%; box-sizing: border-box;">
                      <div style="font-family: var(--font-body); font-size: 0.72rem; font-weight: 800; color: var(--color-brass-dark); display: flex; align-items: center; justify-content: center; gap: 4px;">
                        <Icon name="lock-key" size={14} /> Eksklusif Member
                      </div>
                      <a href="/membership" style="font-size: 0.72rem; color: var(--color-primary); text-decoration: underline; font-weight: 700;">
                        Buka Akses 30 Hari &rarr;
                      </a>
                    </div>
                  ) : sesi.sisa_kuota === 0 ? (
                    <button class="btn-secondary" disabled style="opacity: 0.6; cursor: not-allowed; width: 100%; padding: 10px 16px; font-size: 0.85rem; justify-content: center; box-sizing: border-box;">
                      Sesi Penuh
                    </button>
                  ) : (
                    <a
                      href={`/reservasi?jadwal=${sesi.id}`}
                      class="btn-primary btn-book-cta"
                    >
                      <Icon name="lock-simple" size={15} /> Pesan Kursi Ini
                    </a>
                  )}
                </div>
              </div>

            </div>
          );
        })
      )}
    </section>

  </main>
</SanctuaryLayout>
