---
import SanctuaryLayout from '../../layouts/SanctuaryLayout.astro';
import Icon from '../../components/Icon.astro';
import { actions } from 'astro:actions';
import { AuthService } from '../../../services/auth/auth.service';

const user = Astro.locals.user;
if (user) {
  if (user.peran === 'admin') return Astro.redirect('/admin');
  if (user.peran === 'pelatih') return Astro.redirect('/pelatih');
  return Astro.redirect('/riwayat');
}

const redirectParam = Astro.url.searchParams.get('redirect');
const result = Astro.getActionResult(actions.login);
if (result && !result.error && result.data?.success) {
  const role = result.data.user.peran;
  const defaultTarget = role === 'admin' ? '/admin' : role === 'pelatih' ? '/pelatih' : '/riwayat';
  return Astro.redirect(redirectParam || defaultTarget);
}

const demoAccounts = await AuthService.getDemoAccounts();
---

<SanctuaryLayout title="Masuk Akun — ZEIRA Wellness Sanctuary">
  <main class="page-container" style="padding: 4rem 0 6rem;">
    <div class="container" style="max-width: 520px;">
      
      <div class="surface-card" style="padding: 2.25rem;">
        <div style="text-align: center; margin-bottom: 2rem;">
          <div style="font-family: var(--font-mono); font-size: 0.72rem; color: var(--color-primary); font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; margin-bottom: 6px;">
            PORTAL OTORISASI SANCTUARY
          </div>
          <h1 style="font-family: var(--font-display); font-size: 1.8rem; font-weight: 800; color: var(--text-main); margin: 0 0 8px;">
            Masuk ke Akun Anda
          </h1>
          <p style="font-size: 0.88rem; color: var(--text-muted); margin: 0;">
            Akses dashboard keanggotaan, tiket reservasi kelas, atau portal instruktur.
          </p>
        </div>

        {result?.error && (
          <div style="background: #FDEDED; border: 1px solid #F5C6CB; color: #721C24; padding: 12px 16px; border-radius: var(--radius-md); font-size: 0.85rem; margin-bottom: 1.5rem; display: flex; align-items: center; gap: 8px;">
            <Icon name="warning-circle" size="1.2rem" />
            <span>{result.error.message}</span>
          </div>
        )}

        <form method="POST" action={actions.login} style="display: flex; flex-direction: column; gap: 1.25rem;">
          <div>
            <label for="email" style="display: block; font-size: 0.8rem; font-weight: 700; margin-bottom: 6px; color: var(--text-main);">
              Alamat Email
            </label>
            <input
              type="email"
              id="email"
              name="email"
              required
              placeholder="nama@domain.com"
              style="width: 100%; padding: 10px 14px; border: 1px solid var(--border-hairline); border-radius: var(--radius-md); font-family: var(--font-body); font-size: 0.9rem; background: #FAF8F5;"
            />
          </div>

          <div>
            <label for="kataSandi" style="display: block; font-size: 0.8rem; font-weight: 700; margin-bottom: 6px; color: var(--text-main);">
              Kata Sandi
            </label>
            <input
              type="password"
              id="kataSandi"
              name="kataSandi"
              required
              placeholder="••••••••"
              style="width: 100%; padding: 10px 14px; border: 1px solid var(--border-hairline); border-radius: var(--radius-md); font-family: var(--font-body); font-size: 0.9rem; background: #FAF8F5;"
            />
          </div>

          <button type="submit" class="btn-primary" style="width: 100%; padding: 12px; margin-top: 0.5rem; font-size: 0.95rem;">
            Masuk ke Sanctuary
          </button>
        </form>

        <div style="margin-top: 1.5rem; text-align: center; font-size: 0.85rem; color: var(--text-muted);">
          Belum memiliki akun? <a href="/register" style="color: var(--color-primary); font-weight: 700; text-decoration: underline;">Daftar Akun Baru</a>
        </div>

        <!-- QUICK DEMO SWITCHER -->
        <div style="margin-top: 2.25rem; padding-top: 1.5rem; border-top: 1px dashed var(--border-hairline);">
          <div style="font-family: var(--font-mono); font-size: 0.68rem; font-weight: 700; color: var(--text-subtle); text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 10px;">
            AKSES CEPAT PENGUJIAN (DEMO ACCOUNTS):
          </div>
          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 8px;">
            <button
              type="button"
              class="btn-demo"
              onclick="fillDemo('admin@zeira.sanctuary', 'password123')"
              style="background: #FFF; border: 1px solid var(--border-hairline); padding: 8px 10px; border-radius: var(--radius-sm); font-size: 0.75rem; text-align: left; cursor: pointer;"
            >
              <div style="font-weight: 700; color: var(--color-primary);">1. Founder & Admin</div>
              <div style="font-size: 0.68rem; color: var(--text-main); font-weight: 600;">Anthony Wisnu Jati</div>
              <div style="font-size: 0.64rem; color: var(--text-muted);">admin@zeira.sanctuary</div>
            </button>

            <button
              type="button"
              class="btn-demo"
              onclick="fillDemo('sarah.jenkins@zeira.sanctuary', 'password123')"
              style="background: #FFF; border: 1px solid var(--border-hairline); padding: 8px 10px; border-radius: var(--radius-sm); font-size: 0.75rem; text-align: left; cursor: pointer;"
            >
              <div style="font-weight: 700; color: var(--color-primary);">2. Pelatih Master</div>
              <div style="font-size: 0.68rem; color: var(--text-main); font-weight: 600;">Sarah Jenkins</div>
              <div style="font-size: 0.64rem; color: var(--text-muted);">sarah.jenkins@...</div>
            </button>

            <button
              type="button"
              class="btn-demo"
              onclick="fillDemo('kadek.adi@gmail.com', 'password123')"
              style="background: #FFF; border: 1px solid var(--border-hairline); padding: 8px 10px; border-radius: var(--radius-sm); font-size: 0.75rem; text-align: left; cursor: pointer;"
            >
              <div style="font-weight: 700; color: var(--color-primary);">3. Co-Founder / Member</div>
              <div style="font-size: 0.68rem; color: var(--text-main); font-weight: 600;">I Kadek Adi Sunetra</div>
              <div style="font-size: 0.64rem; color: var(--text-muted);">kadek.adi@gmail.com</div>
            </button>

            <button
              type="button"
              class="btn-demo"
              onclick="fillDemo('budi.santoso@gmail.com', 'password123')"
              style="background: #FFF; border: 1px solid var(--border-hairline); padding: 8px 10px; border-radius: var(--radius-sm); font-size: 0.75rem; text-align: left; cursor: pointer;"
            >
              <div style="font-weight: 700; color: var(--color-primary);">4. Tamu Drop-in</div>
              <div style="font-size: 0.68rem; color: var(--text-main); font-weight: 600;">Budi Santoso</div>
              <div style="font-size: 0.64rem; color: var(--text-muted);">budi.santoso@gmail.com</div>
            </button>
          </div>
        </div>

      </div>

    </div>
  </main>

  <script is:inline>
    function fillDemo(email, pass) {
      document.getElementById('email').value = email;
      document.getElementById('kataSandi').value = pass;
    }
  </script>
</SanctuaryLayout>
