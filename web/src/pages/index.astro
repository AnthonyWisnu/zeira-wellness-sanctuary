---
import SanctuaryLayout from '../layouts/SanctuaryLayout.astro';
import Icon from '../components/Icon.astro';
import { JadwalService } from '../../services/jadwal/jadwal.service';

const user = Astro.locals.user;
const isMemberAktif = !!user?.isMemberAktif;
const { jadwal } = await JadwalService.getKatalogJadwal(isMemberAktif);
const upcomingSessions = jadwal.slice(0, 3);
---

<SanctuaryLayout
  title="ZEIRA SANCTUARY — Ketenangan Pikiran & Presisi Gerak"
  description="Studio mindful movement eksklusif di Batavia: Reformer Pilates presisi, Cadillacs apparatus, Sound Healing holistik, dan Restorative Yoga."
>
  <!-- FULL SCREEN IMMERSIVE HERO CAROUSEL -->
  <section class="hero-carousel" id="home-hero-carousel" aria-label="Suaka Zeira Showcase">
    <!-- Circular Navigation Arrows -->
    <button
      type="button"
      class="carousel-nav-btn carousel-nav-btn--prev"
      id="carousel-prev"
      aria-label="Slide Sebelumnya"
    >
      <Icon name="caret-left" size="1.25rem" weight="bold" />
    </button>
    <button
      type="button"
      class="carousel-nav-btn carousel-nav-btn--next"
      id="carousel-next"
      aria-label="Slide Berikutnya"
    >
      <Icon name="caret-right" size="1.25rem" weight="bold" />
    </button>

    <!-- 3 Slides with Curated Architectural Photography -->
    <div class="hero-carousel__slides">
      <!-- Slide 1: Reformer Atelier -->
      <div class="hero-carousel__slide is-active" data-slide-index="0">
        <img
          src="https://images.unsplash.com/photo-1518611012118-696072aa579a?auto=format&fit=crop&w=1920&q=85"
          alt="Reformer Pilates Atelier"
          class="hero-carousel__img"
        />
        <div class="hero-carousel__scrim"></div>
        <div class="hero-carousel__caption">
          <div class="hero-carousel__container">
            <h1 class="hero-carousel__title">
              Presisi Postural & Kendali Nafas di Tiap Gerakan.
            </h1>
            <p class="hero-carousel__sub">
              Latihan pilates reformer presisi kalibrasi tinggi dengan sistem penguncian kursi 15 menit anti-overbooking.
            </p>

            <!-- Authentic UI Widget Box -->
            <div class="hero-session-card">
              <div class="hero-session-card__info">
                <div class="hero-session-card__meta">
                  <span class="hero-session-card__indicator"></span>
                  <span class="hero-session-card__label">SESI TERDEKAT • 07:00 WIB</span>
                  <span class="hero-session-card__seat">Tersisa 2 Kursi</span>
                </div>
                <div class="hero-session-card__title">Dynamic Reformer Level 1–2</div>
                <div class="hero-session-card__sub">Studio 01 Atelier • Sarah Renata (BASI Certified)</div>
              </div>
              <a href="/jadwal" class="btn-session-action">
                <span>Reservasi Sesi</span>
                <Icon name="arrow-right" size="0.95rem" weight="bold" />
              </a>
            </div>
          </div>
        </div>
      </div>

      <!-- Slide 2: Cadillacs Tower & Postural Atelier -->
      <div class="hero-carousel__slide" data-slide-index="1">
        <img
          src="https://images.unsplash.com/photo-1545205597-3d9d02c29597?auto=format&fit=crop&w=1920&q=85"
          alt="Cadillacs Tower & Postural Atelier"
          class="hero-carousel__img"
        />
        <div class="hero-carousel__scrim"></div>
        <div class="hero-carousel__caption">
          <div class="hero-carousel__container">
            <h1 class="hero-carousel__title">
              Dekompresi Spinal & Penyelarasan Biomekanika.
            </h1>
            <p class="hero-carousel__sub">
              Restorasi kurvatura tulang belakang pada apparatus Cadillacs artisan Eropa dengan bimbingan personal instruktur bersertifikasi.
            </p>

            <!-- Authentic UI Widget Box -->
            <div class="hero-session-card">
              <div class="hero-session-card__info">
                <div class="hero-session-card__meta">
                  <span class="hero-session-card__indicator"></span>
                  <span class="hero-session-card__label">SESI TERDEKAT • 10:30 WIB</span>
                  <span class="hero-session-card__seat">Tersisa 4 Kursi</span>
                </div>
                <div class="hero-session-card__title">Cadillacs Tower & Spinal Flow</div>
                <div class="hero-session-card__sub">Studio 02 Atelier • Kenji Sato (Polestar Master)</div>
              </div>
              <a href="/jadwal" class="btn-session-action">
                <span>Reservasi Sesi</span>
                <Icon name="arrow-right" size="0.95rem" weight="bold" />
              </a>
            </div>
          </div>
        </div>
      </div>

      <!-- Slide 3: Zen Dome Sound Bath -->
      <div class="hero-carousel__slide" data-slide-index="2">
        <img
          src="https://images.unsplash.com/photo-1506126613408-eca07ce68773?auto=format&fit=crop&w=1920&q=85"
          alt="Zen Dome & Tibetan Sound Healing"
          class="hero-carousel__img"
        />
        <div class="hero-carousel__scrim"></div>
        <div class="hero-carousel__caption">
          <div class="hero-carousel__container">
            <h1 class="hero-carousel__title">
              Relaksasi Gelombang Theta & Tibetan Sound Bath.
            </h1>
            <p class="hero-carousel__sub">
              Harmonisasi getaran kristal dan genta simfoni di bawah temaram lilin lebah alami untuk ketenangan batin mutlak.
            </p>

            <!-- Authentic UI Widget Box -->
            <div class="hero-session-card">
              <div class="hero-session-card__info">
                <div class="hero-session-card__meta">
                  <span class="hero-session-card__indicator"></span>
                  <span class="hero-session-card__label">SESI TERDEKAT • 17:30 WIB</span>
                  <span class="hero-session-card__seat" style="color: #FF8080;">Tersisa 1 Kursi</span>
                </div>
                <div class="hero-session-card__title">Sound Bath & Candlelight Yin</div>
                <div class="hero-session-card__sub">Zen Hall Dome • Maya Anindita (Sound Healer)</div>
              </div>
              <a href="/jadwal" class="btn-session-action">
                <span>Reservasi Sesi</span>
                <Icon name="arrow-right" size="0.95rem" weight="bold" />
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Minimalist Centered Indicator Dots -->
    <div class="carousel-dots-bar" role="tablist" aria-label="Pilihan Slide Studio">
      <button
        type="button"
        class="carousel-dot is-active"
        data-slide-target="0"
        role="tab"
        aria-label="Slide 1: Reformer Atelier"
        aria-selected="true"
      ></button>
      <button
        type="button"
        class="carousel-dot"
        data-slide-target="1"
        role="tab"
        aria-label="Slide 2: Cadillacs Tower"
        aria-selected="false"
      ></button>
      <button
        type="button"
        class="carousel-dot"
        data-slide-target="2"
        role="tab"
        aria-label="Slide 3: Zen Dome"
        aria-selected="false"
      ></button>
    </div>
  </section>

  <!-- SECTION: SPLIT (JADWAL KELAS HARI INI & MEMBERSHIP PASSBOOK) -->
  <section class="container home-split">
    <!-- Left: Schedule Box -->
    <div class="surface-card daily-schedule-box">
      <div class="schedule-header">
        <div>
          <div style="display: flex; align-items: center; gap: 8px;">
            <span class="section-tag" style="margin-bottom: 0;">PAPAN RESERVASI</span>
            <span class="pill-tag pill-tag--green">Real-Time Sync</span>
          </div>
          <h3 style="font-family: var(--font-display); font-size: 1.35rem; font-weight: 700; margin-top: 4px;">Jadwal Kelas Studio Hari Ini</h3>
        </div>
        <a href="/jadwal" style="font-family: var(--font-mono); font-size: 0.75rem; font-weight: 700; color: var(--color-primary); display: flex; align-items: center; gap: 4px;">
          Buka Kalender Penuh &rarr;
        </a>
      </div>

      <div class="schedule-list">
        {upcomingSessions.length === 0 ? (
          <div style="padding: 1.5rem; text-align: center; color: var(--text-muted); font-size: 0.85rem;">
            Belum ada jadwal sesi terbuka hari ini. Silakan kunjungi halaman <a href="/jadwal" style="color: var(--color-primary); font-weight: 700; text-decoration: underline;">Jadwal Lengkap</a>.
          </div>
        ) : (
          upcomingSessions.map((sesi) => (
            <div class="schedule-item">
              <div class="schedule-time-badge">
                <div class="schedule-time">
                  {new Date(sesi.waktu_mulai).toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit' })}
                </div>
                <div class="schedule-tz">WIB</div>
              </div>
              <div class="schedule-details">
                <div class="schedule-tags">
                  <span class="pill-tag">{sesi.ruangan.nama}</span>
                  <span class="pill-tag pill-tag--green">{sesi.kategori.nama}</span>
                </div>
                <div class="schedule-class-name">{sesi.judul_sesi}</div>
                <div class="schedule-instructor">Bersama {sesi.pelatih.nama} ({sesi.pelatih.spesialisasi || 'Instructor'})</div>
              </div>
              <div class="schedule-price-col">
                <div class="schedule-price">
                  {sesi.harga_efektif === 0 ? 'GRATIS' : `Rp ${sesi.harga_efektif.toLocaleString('id-ID')}`}
                </div>
                <div class="schedule-seats">
                  {sesi.sisa_kuota === 0 ? 'Penuh' : `Tersisa ${sesi.sisa_kuota} Kursi`}
                </div>
              </div>
              {sesi.sisa_kuota > 0 ? (
                <a href={`/reservasi?jadwal=${sesi.id}`} class="btn-book-sm" style="text-decoration: none; text-align: center;">
                  Pesan
                </a>
              ) : (
                <button class="btn-book-sm" disabled style="opacity: 0.5; cursor: not-allowed;">
                  Penuh
                </button>
              )}
            </div>
          ))
        )}
      </div>
    </div>

    <!-- Right: Membership Passbook Card -->
    <div class="passbook-card">
      <div class="passbook-header">
        <div>
          <span class="section-tag">KEANGGOTAAN FLEKSIBEL</span>
          <h3 style="font-family: var(--font-display); font-size: 1.35rem; font-weight: 700;">Membership Tanpa Drama</h3>
          <p style="font-size: 0.8rem; color: var(--text-muted); margin-top: 2px;">
            Pilih durasi 1, 3, 6, atau 12 bulan dengan akses menyeluruh tanpa biaya tersembunyi.
          </p>
        </div>
        <div class="wax-seal">
          <span>ZEIRA</span>
          <span>PASS</span>
        </div>
      </div>

      <div style="font-family: var(--font-mono); font-size: 0.65rem; font-weight: 700; color: var(--color-brass-dark); text-transform: uppercase;">
        AKSES SANCTUARY PENUH • Tier Pilihan Sanctuary Pass
      </div>

      <!-- Duration Segmented Tabs -->
      <div class="passbook-tabs">
        <div class="passbook-tab-btn passbook-tab-btn--active">1 Bln</div>
        <div class="passbook-tab-btn">3 Bln</div>
        <div class="passbook-tab-btn">6 Bln</div>
        <div class="passbook-tab-btn">12 Bln</div>
      </div>

      <ul class="passbook-benefits">
        <li class="passbook-benefit-item">
          <span class="benefit-check">✓</span>
          <span>Akses seluruh kelas studio unlimited 7 hari/minggu</span>
        </li>
        <li class="passbook-benefit-item">
          <span class="benefit-check">✓</span>
          <span>Priority Window booking kelas 30 hari lebih awal</span>
        </li>
        <li class="passbook-benefit-item">
          <span class="benefit-check">✓</span>
          <span>Dedicated RFID locker pribadi & handuk katun organik</span>
        </li>
        <li class="passbook-benefit-item">
          <span class="benefit-check">✓</span>
          <span>Artisan herbal tonic & complimentary tea lounge</span>
        </li>
      </ul>

      <div class="passbook-bottom">
        <div class="passbook-price-box">
          <span class="passbook-price-label">Mulai Dari</span>
          <span class="passbook-price-val" id="passbook-price-display">Rp 1.050.000 /bln</span>
        </div>
        <a href="/membership" class="btn-primary" style="padding: 10px 18px; font-size: 0.85rem;">
          Eksplor Membership
        </a>
      </div>
    </div>
  </section>

  <!-- SECTION: TESTIMONIAL ONLY (NO SLOP GUARANTEE CARD) -->
  <section class="container home-quote-section">
    <div class="surface-card testimonial-card">
      <div class="testimonial-card__quote-col">
        <p class="testimonial-quote">
          “Sistem locking 15 menit dan kepastian matras di ZEIRA adalah game changer. Tidak ada lagi drama overbooking atau berebut tempat di kelas Reformer. Fasilitas RFID locker dan artisan herbal lounge-nya benar-benar menyempurnakan ketenangan setelah jam kerja di Sudirman.”
        </p>
      </div>
      <div class="testimonial-author">
        <div class="testimonial-author-avatar">
          <img src="https://images.unsplash.com/photo-1517841905240-472988babdf9?auto=format&fit=crop&w=120&q=80" alt="Nadira Alatas" />
        </div>
        <div class="testimonial-author-meta">
          <div class="author-name">Nadira Alatas</div>
          <div class="author-title">Member Tahunan • Sejak Maret 2024</div>
          <div class="author-verified">
            <Icon name="shield-check" size="0.85rem" weight="bold" />
            <span>Verified Sanctuary Member</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CLIENT-SIDE CAROUSEL INTERACTION SCRIPT -->
  <script is:inline>
    (function () {
      const carousel = document.getElementById('home-hero-carousel');
      if (!carousel) return;

      const slides = carousel.querySelectorAll('.hero-carousel__slide');
      const dots = carousel.querySelectorAll('.carousel-dot');
      const prevBtn = document.getElementById('carousel-prev');
      const nextBtn = document.getElementById('carousel-next');

      let currentIndex = 0;
      let timer = null;

      function goToSlide(index) {
        if (index < 0) {
          currentIndex = slides.length - 1;
        } else if (index >= slides.length) {
          currentIndex = 0;
        } else {
          currentIndex = index;
        }

        slides.forEach((slide, idx) => {
          if (idx === currentIndex) {
            slide.classList.add('is-active');
          } else {
            slide.classList.remove('is-active');
          }
        });

        dots.forEach((dot, idx) => {
          if (idx === currentIndex) {
            dot.classList.add('is-active');
            dot.setAttribute('aria-selected', 'true');
          } else {
            dot.classList.remove('is-active');
            dot.setAttribute('aria-selected', 'false');
          }
        });
      }

      function nextSlide() {
        goToSlide(currentIndex + 1);
      }

      function prevSlide() {
        goToSlide(currentIndex - 1);
      }

      if (prevBtn) {
        prevBtn.addEventListener('click', () => {
          prevSlide();
          resetAutoPlay();
        });
      }

      if (nextBtn) {
        nextBtn.addEventListener('click', () => {
          nextSlide();
          resetAutoPlay();
        });
      }

      dots.forEach((dot) => {
        dot.addEventListener('click', () => {
          const target = parseInt(dot.getAttribute('data-slide-target') || '0', 10);
          goToSlide(target);
          resetAutoPlay();
        });
      });

      // Keyboard navigation
      window.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowLeft') {
          prevSlide();
          resetAutoPlay();
        } else if (e.key === 'ArrowRight') {
          nextSlide();
          resetAutoPlay();
        }
      });

      function autoPlay() {
        nextSlide();
      }

      function startAutoPlay() {
        timer = setInterval(autoPlay, 6500);
      }

      function stopAutoPlay() {
        if (timer) clearInterval(timer);
      }

      function resetAutoPlay() {
        stopAutoPlay();
        startAutoPlay();
      }

      carousel.addEventListener('mouseenter', stopAutoPlay);
      carousel.addEventListener('mouseleave', startAutoPlay);

      startAutoPlay();
    })();
  </script>
</SanctuaryLayout>
