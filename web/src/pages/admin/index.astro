---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import Icon from '../../components/Icon.astro';
import { actions } from 'astro:actions';
import { AdminService } from '../../../services/admin/admin.service';

const user = Astro.locals.user;
if (!user || user.peran !== 'admin') {
  return Astro.redirect('/login?redirect=/admin');
}

const actionResultJadwal = Astro.getActionResult(actions.createJadwal);
const actionResultLoker = Astro.getActionResult(actions.updateStatusLoker);
const actionResultRuangan = Astro.getActionResult(actions.createRuangan);
const actionResultKategori = Astro.getActionResult(actions.createKategori);

const metrics = await AdminService.getDashboardMetrics();
const jadwalList = await AdminService.getJadwalList();
const ruanganList = await AdminService.getRuanganList();
const kategoriList = await AdminService.getKategoriList();
const pelatihList = await AdminService.getDaftarPelatih();
const lokerList = await AdminService.getLokerList();
const rekapPesanan = await AdminService.getRekapPesanan();

const currentTab = Astro.url.searchParams.get('tab') || 'overview';

function formatJamMenit(d: Date | string): string {
  const date = typeof d === 'string' ? new Date(d) : d;
  return date.toLocaleTimeString('id-ID', {
    hour: '2-digit',
    minute: '2-digit',
    hour12: false,
    timeZone: 'Asia/Makassar',
  }).replace('.', ':');
}

function formatTanggalLengkap(d: Date | string): string {
  const date = typeof d === 'string' ? new Date(d) : d;
  return date.toLocaleDateString('id-ID', {
    weekday: 'long',
    day: 'numeric',
    month: 'long',
    year: 'numeric',
    timeZone: 'Asia/Makassar',
  });
}

function formatTanggalSingkat(d: Date | string): string {
  const date = typeof d === 'string' ? new Date(d) : d;
  return date.toLocaleDateString('id-ID', {
    day: 'numeric',
    month: 'short',
    year: 'numeric',
    timeZone: 'Asia/Makassar',
  });
}
---

<DashboardLayout title="Dashboard Administrator" activeMenu={currentTab}>
  <!-- FEEDBACK NOTIFIKASI -->
  {(actionResultJadwal?.error || actionResultLoker?.error || actionResultRuangan?.error || actionResultKategori?.error) && (
    <div class="feedback-banner feedback-banner--error">
      <Icon name="warning-circle" size="1.2rem" />
      <span>{actionResultJadwal?.error?.message || actionResultLoker?.error?.message || actionResultRuangan?.error?.message || actionResultKategori?.error?.message}</span>
    </div>
  )}
  {(actionResultJadwal?.data?.success || actionResultLoker?.data?.success || actionResultRuangan?.data?.success || actionResultKategori?.data?.success) && (
    <div class="feedback-banner feedback-banner--success">
      <Icon name="check-circle" size="1.2rem" />
      <span>Perubahan data berhasil disimpan ke basis data PostgreSQL.</span>
    </div>
  )}

  <!-- ========================================================================= -->
  <!-- VIEW 1: RINGKASAN & METRIK STUDIO                                         -->
  <!-- ========================================================================= -->
  {currentTab === 'overview' && (
    <div>
      <div class="page-header" style="margin-bottom: 1.75rem;">
        <h1 class="page-title" style="margin: 0;">Ringkasan Studio</h1>
      </div>

      <!-- 4 KARTU METRIK UTAMA -->
      <div class="kpi-grid">
        <div class="surface-card kpi-card">
          <div class="kpi-label">PENDAPATAN LUNAS</div>
          <div class="kpi-value">Rp {metrics.totalPendapatan.toLocaleString('id-ID')}</div>
        </div>

        <div class="surface-card kpi-card">
          <div class="kpi-label">MEMBER AKTIF</div>
          <div class="kpi-value kpi-value--brass">{metrics.totalMemberAktif} Member</div>
        </div>

        <div class="surface-card kpi-card">
          <div class="kpi-label">SESI KELAS AKTIF</div>
          <div class="kpi-value">{metrics.totalJadwalAktif} Sesi</div>
        </div>

        <div class="surface-card kpi-card">
          <div class="kpi-label">LOKER TERISI</div>
          <div class="kpi-value">{metrics.lokerDigunakan} / {metrics.totalLoker} Loker</div>
        </div>
      </div>

      <!-- 2-COLUMN OVERVIEW PREVIEW -->
      <div class="overview-dual-grid">
        <!-- UPCOMING CLASSES -->
        <div class="surface-card overview-card">
          <div class="overview-card__header">
            <div class="overview-card__heading">
              <Icon name="calendar-check" size="1.2rem" />
              <h3 class="overview-card__title">Sesi Kelas Terdekat</h3>
            </div>
            <a href="/admin?tab=jadwal" class="overview-card__link">
              Kelola Sesi &rarr;
            </a>
          </div>

          <div class="overview-item-list">
            {jadwalList.slice(0, 4).map((j) => (
              <div class="overview-item">
                <div class="overview-item__body">
                  <div class="overview-item__title">{j.judul_sesi}</div>
                  <div class="overview-spec-box">
                    <div class="overview-spec-row">
                      <span class="overview-spec-label">Waktu:</span>
                      <span class="overview-spec-val">{formatTanggalSingkat(j.waktu_mulai)}, {formatJamMenit(j.waktu_mulai)} WITA</span>
                    </div>
                    <div class="overview-spec-row">
                      <span class="overview-spec-label">Ruangan:</span>
                      <span class="overview-spec-val">{j.tb_ruangan.nama_ruangan}</span>
                    </div>
                    <div class="overview-spec-row">
                      <span class="overview-spec-label">Pelatih:</span>
                      <span class="overview-spec-val">{j.tb_pengguna.nama_lengkap}</span>
                    </div>
                  </div>
                </div>
                <div class="overview-item__aside">
                  <span class="pill-tag pill-tag--brass">
                    {j.jumlah_terisi} / {j.kapasitas_maksimal} Kursi
                  </span>
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- RECENT TRANSACTIONS -->
        <div class="surface-card overview-card">
          <div class="overview-card__header">
            <div class="overview-card__heading">
              <Icon name="receipt" size="1.2rem" />
              <h3 class="overview-card__title">Transaksi Pesanan Terkini</h3>
            </div>
            <a href="/admin?tab=transaksi" class="overview-card__link">
              Lihat Buku Besar &rarr;
            </a>
          </div>

          <div class="overview-item-list">
            {rekapPesanan.slice(0, 4).map((p) => (
              <div class="overview-item">
                <div class="overview-item__body">
                  <div class="overview-item__title">{p.tb_pengguna?.nama_lengkap || 'Pelanggan'}</div>
                  <div class="overview-spec-box">
                    <div class="overview-spec-row">
                      <span class="overview-spec-label">Kode:</span>
                      <span class="overview-spec-val mono-val">{p.kode_pesanan}</span>
                    </div>
                    <div class="overview-spec-row">
                      <span class="overview-spec-label">Tipe:</span>
                      <span class="overview-spec-val">{p.tipe_pesanan.toUpperCase()}</span>
                    </div>
                  </div>
                </div>
                <div class="overview-item__aside">
                  <div class="overview-amount">
                    Rp {Number(p.total_bayar).toLocaleString('id-ID')}
                  </div>
                  <span class={`pill-tag ${p.status_pembayaran === 'lunas' ? 'pill-tag--green' : 'pill-tag--brass'}`}>
                    {p.status_pembayaran.toUpperCase()}
                  </span>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  )}

  <!-- ========================================================================= -->
  <!-- VIEW 2: JADWAL & SESI KELAS                                               -->
  <!-- ========================================================================= -->
  {currentTab === 'jadwal' && (
    <div>
      <div class="schedule-header-bar">
        <h1 class="page-title" style="margin: 0;">Jadwal & Sesi Kelas</h1>
        <div class="schedule-stat-chip">
          <span class="schedule-stat-chip__label">TOTAL SESI:</span>
          <span class="schedule-stat-chip__val">{jadwalList.length}</span>
          <span class="schedule-stat-chip__desc">Kelas Terdaftar</span>
        </div>
      </div>

      <div class="jadwal-layout-grid">
        <!-- DAFTAR JADWAL KELAS -->
        <div>

          <div class="jadwal-card-list">
            {jadwalList.map((j) => (
              <div class="surface-card admin-jadwal-card">
                <div class="admin-jadwal-main">
                  <div class="admin-jadwal-tags">
                    <span class="pill-tag pill-tag--brass">
                      {j.tb_kategori_layanan.nama_kategori}
                    </span>
                    {j.status_sesi !== 'terjadwal' && (
                      <span class="pill-tag pill-tag--neutral">
                        {j.status_sesi.toUpperCase()}
                      </span>
                    )}
                  </div>

                  <h4 class="admin-jadwal-title">
                    {j.judul_sesi}
                  </h4>

                  <!-- PER-ROW SPEC PANEL (ZERO INLINE BULLETS) -->
                  <div class="admin-spec-panel">
                    <div class="admin-spec-row">
                      <div class="admin-spec-key">TANGGAL SESI</div>
                      <div class="admin-spec-val" style="font-weight: 700;">
                        {formatTanggalLengkap(j.waktu_mulai)}
                      </div>
                    </div>

                    <div class="admin-spec-row">
                      <div class="admin-spec-key">JAM PELAKSANAAN</div>
                      <div class="admin-spec-val">
                        <span class="mono-val">{formatJamMenit(j.waktu_mulai)} – {formatJamMenit(j.waktu_selesai)}</span> WITA
                      </div>
                    </div>

                    <div class="admin-spec-row">
                      <div class="admin-spec-key">RUANGAN & LOKASI</div>
                      <div class="admin-spec-val" style="font-weight: 700;">
                        {j.tb_ruangan.nama_ruangan} <span style="font-weight: 500; color: var(--text-muted);">({j.tb_ruangan.lokasi})</span>
                      </div>
                    </div>

                    <div class="admin-spec-row">
                      <div class="admin-spec-key">INSTRUKTUR</div>
                      <div class="admin-spec-val">
                        {j.tb_pengguna.nama_lengkap}
                      </div>
                    </div>

                    <div class="admin-spec-row">
                      <div class="admin-spec-key">TARIF KELAS</div>
                      <div class="admin-spec-val admin-rates-flex">
                        <span class="rate-chip rate-chip--member">
                          <span class="rate-chip__label">MEMBER:</span>
                          <strong>Rp {Number(j.harga_member).toLocaleString('id-ID')}</strong>
                        </span>
                        <span class="rate-chip rate-chip--guest">
                          <span class="rate-chip__label">TAMU:</span>
                          <strong>Rp {Number(j.harga_non_member).toLocaleString('id-ID')}</strong>
                        </span>
                      </div>
                    </div>

                    <div class="admin-spec-row">
                      <div class="admin-spec-key">BATAS PEMBATALAN</div>
                      <div class="admin-spec-val">
                        Maksimal {j.batas_batal_jam} Jam sebelum sesi dimulai
                      </div>
                    </div>
                  </div>
                </div>

                <div class="admin-jadwal-aside">
                  <div class="quota-pill">
                    <div class="quota-pill__count">{j.jumlah_terisi} / {j.kapasitas_maksimal}</div>
                    <div class="quota-pill__label">KURSI TERISI</div>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- FORMULIR BUAT JADWAL BARU -->
        <div class="surface-card admin-form-card">
          <h3 class="admin-form-title">
            <Icon name="calendar-check" size="1.2rem" />
            <span>+ Buat Jadwal Sesi Baru</span>
          </h3>

          <form method="POST" action={actions.createJadwal} class="admin-form">
            <div class="form-group">
              <label for="judulSesi" class="form-label">Judul Sesi</label>
              <input
                type="text"
                id="judulSesi"
                name="judulSesi"
                required
                placeholder="Contoh: Yin Yoga & Breathwork"
                class="form-input"
              />
            </div>

            <div class="form-group">
              <label for="kategoriId" class="form-label">Kategori Layanan</label>
              <select id="kategoriId" name="kategoriId" required class="form-select">
                {kategoriList.map((k) => (
                  <option value={k.id}>{k.nama_kategori}</option>
                ))}
              </select>
            </div>

            <div class="form-group">
              <label for="pelatihId" class="form-label">Pelatih / Trainer</label>
              <select id="pelatihId" name="pelatihId" required class="form-select">
                {pelatihList.map((p) => (
                  <option value={p.id}>{p.nama_lengkap}</option>
                ))}
              </select>
            </div>

            <div class="form-group">
              <label for="ruanganId" class="form-label">Ruangan Studio</label>
              <select id="ruanganId" name="ruanganId" required class="form-select">
                {ruanganList.map((r) => (
                  <option value={r.id}>{r.nama_ruangan} (Maks: {r.kapasitas_maksimal})</option>
                ))}
              </select>
            </div>

            <div class="form-group-stack">
              <div class="form-group">
                <label for="waktuMulai" class="form-label">Waktu Mulai Sesi</label>
                <input
                  type="datetime-local"
                  id="waktuMulai"
                  name="waktuMulai"
                  required
                  class="form-input"
                />
              </div>
              <div class="form-group">
                <label for="waktuSelesai" class="form-label">Waktu Selesai Sesi</label>
                <input
                  type="datetime-local"
                  id="waktuSelesai"
                  name="waktuSelesai"
                  required
                  class="form-input"
                />
              </div>
            </div>

            <div class="form-row-dual">
              <div class="form-group">
                <label for="kapasitasMaksimal" class="form-label">Kuota Kursi</label>
                <input
                  type="number"
                  id="kapasitasMaksimal"
                  name="kapasitasMaksimal"
                  required
                  min="1"
                  max="50"
                  value="10"
                  class="form-input mono-val"
                />
              </div>
              <div class="form-group">
                <label for="batasBatalJam" class="form-label">Batas Batal (Jam)</label>
                <input
                  type="number"
                  id="batasBatalJam"
                  name="batasBatalJam"
                  required
                  min="0"
                  value="24"
                  class="form-input mono-val"
                />
              </div>
            </div>

            <div class="form-row-dual">
              <div class="form-group">
                <label for="hargaMember" class="form-label">Harga Member</label>
                <input
                  type="number"
                  id="hargaMember"
                  name="hargaMember"
                  required
                  min="0"
                  value="75000"
                  class="form-input mono-val"
                />
              </div>
              <div class="form-group">
                <label for="hargaNonMember" class="form-label">Harga Tamu</label>
                <input
                  type="number"
                  id="hargaNonMember"
                  name="hargaNonMember"
                  required
                  min="0"
                  value="150000"
                  class="form-input mono-val"
                />
              </div>
            </div>

            <button type="submit" class="btn-primary" style="width: 100%; padding: 11px; margin-top: 6px;">
              Simpan & Publikasikan Sesi
            </button>
          </form>
        </div>
      </div>
    </div>
  )}

  <!-- ========================================================================= -->
  <!-- VIEW 3: RUANGAN & INVENTARIS LOKER                                        -->
  <!-- ========================================================================= -->
  {currentTab === 'ruangan' && (
    <div>
      <div class="schedule-header-bar">
        <h1 class="page-title" style="margin: 0;">Ruangan & Lemari Loker</h1>
        <div class="schedule-stat-chip">
          <span class="schedule-stat-chip__label">TOTAL LOKER:</span>
          <span class="schedule-stat-chip__val">{lokerList.length}</span>
          <span class="schedule-stat-chip__desc">Loker Pribadi</span>
        </div>
      </div>

      <!-- INVENTARIS LOKER -->
      <div style="margin-bottom: 3rem;">
        <h3 class="section-title" style="margin-bottom: 1.25rem; display: flex; align-items: center; gap: 8px;">
          <Icon name="lock-key" size="1.2rem" />
          <span>Inventaris Lemari Loker</span>
        </h3>

        <div class="loker-grid">
          {lokerList.map((l) => {
            const activeRent = l.tb_keanggotaan[0];
            const isUsed = l.status === 'digunakan' || !!activeRent;
            const isMaintenance = l.status === 'perawatan';

            return (
              <div class="surface-card loker-card">
                <div class="loker-header">
                  <span class="loker-number">{l.nomor_loker}</span>
                  <span class={`pill-tag ${isMaintenance ? 'pill-tag--red' : isUsed ? 'pill-tag--green' : 'pill-tag--neutral'}`}>
                    {isMaintenance ? 'PERAWATAN' : isUsed ? 'DIGUNAKAN MEMBER' : 'TERSEDIA'}
                  </span>
                </div>

                <div class="loker-area">
                  <span class="loker-area-label">Lokasi:</span>
                  <strong>{l.lokasi_area}</strong>
                </div>

                {activeRent && (
                  <div class="loker-renter-card">
                    <div class="loker-renter-name">Penyewa: <strong>{activeRent.tb_pengguna.nama_lengkap}</strong></div>
                    <div class="loker-renter-exp">Berlaku s/d: {formatTanggalSingkat(activeRent.tanggal_berakhir)}</div>
                  </div>
                )}

                {!activeRent && !isMaintenance && (
                  <div class="loker-available-note">
                    Loker siap dialokasikan saat ada member baru mendaftar.
                  </div>
                )}

                <form method="POST" action={actions.updateStatusLoker} style="margin-top: auto;">
                  <input type="hidden" name="lokerId" value={l.id} />
                  <input
                    type="hidden"
                    name="status"
                    value={l.status === 'perawatan' ? 'tersedia' : 'perawatan'}
                  />
                  <button
                    type="submit"
                    class="btn-secondary"
                    style="width: 100%; padding: 7px; font-size: 0.76rem; justify-content: center;"
                  >
                    {l.status === 'perawatan' ? 'Aktifkan Kembali' : 'Tandai Perawatan'}
                  </button>
                </form>
              </div>
            );
          })}
        </div>
      </div>

      <!-- MASTER RUANGAN & KATEGORI -->
      <div class="master-dual-grid">
        <!-- MASTER RUANGAN -->
        <div class="surface-card master-card">
          <h4 class="master-card-title">
            <Icon name="door" size="1.2rem" />
            <span>Ruangan Studio Fisik</span>
          </h4>

          <div class="master-item-list">
            {ruanganList.map((r) => (
              <div class="master-item">
                <div>
                  <div class="master-item-name">{r.nama_ruangan}</div>
                  <div class="master-item-sub">{r.lokasi}</div>
                </div>
                <span class="pill-tag pill-tag--brass">
                  Kapasitas: {r.kapasitas_maksimal} Orang
                </span>
              </div>
            ))}
          </div>

          <form method="POST" action={actions.createRuangan} class="master-form">
            <div class="master-form-heading">+ Tambah Ruangan Baru</div>
            <input type="text" name="nama" required placeholder="Nama Ruangan (misal: Studio Zen)" class="form-input" />
            <input type="text" name="lokasi" required placeholder="Lokasi (misal: Lantai 2 Sayap Barat)" class="form-input" />
            <input type="number" name="kapasitas" required min="1" max="100" value="10" placeholder="Kapasitas Maksimal" class="form-input mono-val" />
            <button type="submit" class="btn-primary" style="padding: 9px; font-size: 0.82rem; margin-top: 4px;">Simpan Ruangan</button>
          </form>
        </div>

        <!-- MASTER KATEGORI -->
        <div class="surface-card master-card">
          <h4 class="master-card-title">
            <Icon name="sparkle" size="1.2rem" />
            <span>Kategori Layanan Studio</span>
          </h4>

          <div class="master-item-list">
            {kategoriList.map((k) => (
              <div class="master-item">
                <div>
                  <div class="master-item-name">{k.nama_kategori}</div>
                  <div class="master-item-sub mono-val">/{k.slug}</div>
                </div>
                <span class="pill-tag pill-tag--brass">
                  {k.ikon}
                </span>
              </div>
            ))}
          </div>

          <form method="POST" action={actions.createKategori} class="master-form">
            <div class="master-form-heading">+ Tambah Kategori Baru</div>
            <input type="text" name="nama" required placeholder="Nama Kategori (misal: Sound Bath Therapy)" class="form-input" />
            <input type="text" name="slug" required placeholder="Slug (misal: sound-bath)" class="form-input" />
            <input type="text" name="deskripsi" placeholder="Deskripsi Singkat" class="form-input" />
            <button type="submit" class="btn-primary" style="padding: 9px; font-size: 0.82rem; margin-top: 4px;">Simpan Kategori</button>
          </form>
        </div>
      </div>
    </div>
  )}

  <!-- ========================================================================= -->
  <!-- VIEW 4: BUKU BESAR TRANSAKSI                                              -->
  <!-- ========================================================================= -->
  {currentTab === 'transaksi' && (
    <div>
      <div class="schedule-header-bar">
        <h1 class="page-title" style="margin: 0;">Buku Besar Transaksi</h1>
        <div class="schedule-stat-chip">
          <span class="schedule-stat-chip__label">TOTAL TRANSAKSI:</span>
          <span class="schedule-stat-chip__val">{rekapPesanan.length}</span>
          <span class="schedule-stat-chip__desc">Pesanan Tercatat</span>
        </div>
      </div>

      <div class="surface-card ledger-card">
        <table class="ledger-table">
          <thead>
            <tr>
              <th>Kode Pesanan</th>
              <th>Pelanggan</th>
              <th>Tipe</th>
              <th>Total Bayar</th>
              <th>Metode</th>
              <th>Status</th>
              <th>Waktu</th>
            </tr>
          </thead>
          <tbody>
            {rekapPesanan.map((p) => (
              <tr>
                <td class="td-code">
                  {p.kode_pesanan}
                </td>
                <td>
                  <div class="td-user-name">
                    {p.tb_pengguna?.nama_lengkap || 'Pengguna'}
                  </div>
                  <div class="td-user-email">
                    {p.tb_pengguna?.email}
                  </div>
                </td>
                <td>
                  <span class="pill-tag pill-tag--brass">
                    {p.tipe_pesanan.toUpperCase()}
                  </span>
                </td>
                <td class="td-amount">
                  Rp {Number(p.total_bayar).toLocaleString('id-ID')}
                </td>
                <td class="td-method">
                  {p.metode_pembayaran ? p.metode_pembayaran.toUpperCase() : 'MIDTRANS'}
                </td>
                <td>
                  <span class={`pill-tag ${p.status_pembayaran === 'lunas' ? 'pill-tag--green' : 'pill-tag--brass'}`}>
                    {p.status_pembayaran.toUpperCase()}
                  </span>
                </td>
                <td class="td-date">
                  {formatTanggalSingkat(p.waktu_dibuat)}, {formatJamMenit(p.waktu_dibuat)} WITA
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  )}
</DashboardLayout>

<style is:global>
  /* HEADERS */
  .page-header {
    margin-bottom: 2rem;
  }
  .page-eyebrow {
    font-family: var(--font-body);
    font-size: 0.75rem;
    color: var(--color-primary);
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
