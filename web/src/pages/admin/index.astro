---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import Icon from '../../components/Icon.astro';
import { actions } from 'astro:actions';
import { AdminService } from '../../../services/admin/admin.service';

const user = Astro.locals.user;
if (!user || user.peran !== 'admin') {
  return Astro.redirect('/login?redirect=/admin');
}

const actionResultJadwal = Astro.getActionResult(actions.createJadwal);
const actionResultLoker = Astro.getActionResult(actions.updateStatusLoker);
const actionResultRuangan = Astro.getActionResult(actions.createRuangan);
const actionResultKategori = Astro.getActionResult(actions.createKategori);

const metrics = await AdminService.getDashboardMetrics();
const jadwalList = await AdminService.getJadwalList();
const ruanganList = await AdminService.getRuanganList();
const kategoriList = await AdminService.getKategoriList();
const pelatihList = await AdminService.getDaftarPelatih();
const lokerList = await AdminService.getLokerList();
const rekapPesanan = await AdminService.getRekapPesanan();

const currentTab = Astro.url.searchParams.get('tab') || 'overview';
---

<DashboardLayout title="Dashboard Administrator" activeMenu={currentTab}>
  
  <!-- FEEDBACK NOTIFIKASI -->
  {(actionResultJadwal?.error || actionResultLoker?.error || actionResultRuangan?.error || actionResultKategori?.error) && (
    <div style="background: #FDEDED; border: 1px solid #F5C6CB; color: #721C24; padding: 12px 16px; border-radius: var(--radius-md); font-size: 0.85rem; margin-bottom: 1.5rem; display: flex; align-items: center; gap: 8px;">
      <Icon name="warning-circle" size="1.2rem" />
      <span>{actionResultJadwal?.error?.message || actionResultLoker?.error?.message || actionResultRuangan?.error?.message || actionResultKategori?.error?.message}</span>
    </div>
  )}
  {(actionResultJadwal?.data?.success || actionResultLoker?.data?.success || actionResultRuangan?.data?.success || actionResultKategori?.data?.success) && (
    <div style="background: #EDF7EE; border: 1px solid #C8E6C9; color: #1B5E20; padding: 12px 16px; border-radius: var(--radius-md); font-size: 0.85rem; margin-bottom: 1.5rem; display: flex; align-items: center; gap: 8px;">
      <Icon name="check-circle" size="1.2rem" />
      <span>Perubahan data berhasil disimpan ke basis data PostgreSQL.</span>
    </div>
  )}

  <!-- VIEW 1: RINGKASAN & METRIK STUDIO -->
  {currentTab === 'overview' && (
    <div>
      <div style="margin-bottom: 2rem;">
        <div style="font-family: var(--font-mono); font-size: 0.72rem; color: var(--color-primary); font-weight: 800; letter-spacing: 0.1em; text-transform: uppercase;">
          RINGKASAN EKSEKUTIF
        </div>
        <h1 style="font-family: var(--font-display); font-size: 1.85rem; font-weight: 800; color: var(--text-main); margin: 4px 0;">
          Ringkasan & Metrik Studio
        </h1>
        <p style="font-size: 0.88rem; color: var(--text-muted); margin: 0;">
          Performa operasional sanctuary, okupansi fasilitas RFID, dan ringkasan aktivitas terkini.
        </p>
      </div>

      <!-- 4 KARTU METRIK UTAMA -->
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1.25rem; margin-bottom: 2.25rem;">
        <div class="surface-card" style="padding: 1.35rem;">
          <div style="font-family: var(--font-mono); font-size: 0.68rem; font-weight: 700; color: var(--text-subtle); text-transform: uppercase;">
            TOTAL PENDAPATAN LUNAS
          </div>
          <div style="font-family: var(--font-mono); font-size: 1.65rem; font-weight: 800; color: var(--color-primary); margin: 6px 0 2px;">
            Rp {metrics.totalPendapatan.toLocaleString('id-ID')}
          </div>
          <div style="font-size: 0.75rem; color: var(--text-muted);">Dari transaksi pesanan lunas</div>
        </div>

        <div class="surface-card" style="padding: 1.35rem;">
          <div style="font-family: var(--font-mono); font-size: 0.68rem; font-weight: 700; color: var(--text-subtle); text-transform: uppercase;">
            MEMBER AKTIF
          </div>
          <div style="font-family: var(--font-mono); font-size: 1.65rem; font-weight: 800; color: var(--color-brass-dark); margin: 6px 0 2px;">
            {metrics.totalMemberAktif} Member
          </div>
          <div style="font-size: 0.75rem; color: var(--text-muted);">Total akun: {metrics.totalPengguna} pengguna</div>
        </div>

        <div class="surface-card" style="padding: 1.35rem;">
          <div style="font-family: var(--font-mono); font-size: 0.68rem; font-weight: 700; color: var(--text-subtle); text-transform: uppercase;">
            SESI KELAS AKTIF
          </div>
          <div style="font-family: var(--font-mono); font-size: 1.65rem; font-weight: 800; color: var(--text-main); margin: 6px 0 2px;">
            {metrics.totalJadwalAktif} Sesi
          </div>
          <div style="font-size: 0.75rem; color: var(--text-muted);">Siap dipesan member & tamu</div>
        </div>

        <div class="surface-card" style="padding: 1.35rem;">
          <div style="font-family: var(--font-mono); font-size: 0.68rem; font-weight: 700; color: var(--text-subtle); text-transform: uppercase;">
            OKUPANSI LOKER PRIBADI
          </div>
          <div style="font-family: var(--font-mono); font-size: 1.65rem; font-weight: 800; color: var(--text-main); margin: 6px 0 2px;">
            {metrics.lokerDigunakan} / {metrics.totalLoker} Loker
          </div>
          <div style="font-size: 0.75rem; color: var(--text-muted);">{metrics.lokerTersedia} Loker siap disewa</div>
        </div>
      </div>

      <!-- 2-COLUMN OVERVIEW PREVIEW -->
      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.75rem;">
        
        <!-- UPCOMING CLASSES -->
        <div class="surface-card" style="padding: 1.5rem;">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem;">
            <div style="display: flex; align-items: center; gap: 8px;">
              <Icon name="calendar-check" size="1.2rem" />
              <h3 style="font-family: var(--font-display); font-size: 1.15rem; font-weight: 800; margin: 0; color: var(--text-main);">
                Sesi Kelas Terdekat
              </h3>
            </div>
            <a href="/admin?tab=jadwal" style="font-size: 0.78rem; color: var(--color-primary); font-weight: 700; text-decoration: none;">
              Kelola Sesi &rarr;
            </a>
          </div>

          <div style="display: flex; flex-direction: column; gap: 10px;">
            {jadwalList.slice(0, 4).map((j) => (
              <div style="padding: 12px; background: #FFF; border: 1px solid var(--border-hairline); border-radius: var(--radius-sm); display: flex; justify-content: space-between; align-items: center;">
                <div>
                  <div style="font-weight: 700; font-size: 0.88rem; color: var(--text-main); margin-bottom: 2px;">
                    {j.judul_sesi}
                  </div>
                  <div style="font-size: 0.75rem; color: var(--text-muted);">
                    {j.tb_ruangan.nama_ruangan} • {new Date(j.waktu_mulai).toLocaleDateString('id-ID', { day: 'numeric', month: 'short' })} • Instruktur: {j.tb_pengguna.nama_lengkap}
                  </div>
                </div>
                <div style="text-align: right;">
                  <span class="pill-tag pill-tag--brass" style="font-size: 0.65rem;">
                    {j.jumlah_terisi} / {j.kapasitas_maksimal} Kursi
                  </span>
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- RECENT TRANSACTIONS -->
        <div class="surface-card" style="padding: 1.5rem;">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem;">
            <div style="display: flex; align-items: center; gap: 8px;">
              <Icon name="receipt" size="1.2rem" />
              <h3 style="font-family: var(--font-display); font-size: 1.15rem; font-weight: 800; margin: 0; color: var(--text-main);">
                Transaksi Pesanan Terkini
              </h3>
            </div>
            <a href="/admin?tab=transaksi" style="font-size: 0.78rem; color: var(--color-primary); font-weight: 700; text-decoration: none;">
              Lihat Buku Besar &rarr;
            </a>
          </div>

          <div style="display: flex; flex-direction: column; gap: 10px;">
            {rekapPesanan.slice(0, 4).map((p) => (
              <div style="padding: 12px; background: #FFF; border: 1px solid var(--border-hairline); border-radius: var(--radius-sm); display: flex; justify-content: space-between; align-items: center;">
                <div>
                  <div style="font-weight: 700; font-size: 0.88rem; color: var(--text-main); margin-bottom: 2px;">
                    {p.tb_pengguna?.nama_lengkap || 'Pelanggan'}
                  </div>
                  <div style="font-family: var(--font-mono); font-size: 0.72rem; color: var(--text-muted);">
                    {p.kode_pesanan} • {p.tipe_pesanan.toUpperCase()}
                  </div>
                </div>
                <div style="text-align: right;">
                  <div style="font-family: var(--font-mono); font-weight: 800; font-size: 0.88rem; color: var(--color-primary);">
                    Rp {Number(p.total_bayar).toLocaleString('id-ID')}
                  </div>
                  <span class={`pill-tag ${p.status_pembayaran === 'lunas' ? 'pill-tag--green' : 'pill-tag--brass'}`} style="font-size: 0.62rem;">
                    {p.status_pembayaran.toUpperCase()}
                  </span>
                </div>
              </div>
            ))}
          </div>
        </div>

      </div>
    </div>
  )}

  <!-- VIEW 2: JADWAL & SESI KELAS -->
  {currentTab === 'jadwal' && (
    <div>
      <div style="margin-bottom: 2rem;">
        <div style="font-family: var(--font-mono); font-size: 0.72rem; color: var(--color-primary); font-weight: 800; letter-spacing: 0.1em; text-transform: uppercase;">
          STUDIO SCHEDULER
        </div>
        <h1 style="font-family: var(--font-display); font-size: 1.85rem; font-weight: 800; color: var(--text-main); margin: 4px 0;">
          Jadwal & Sesi Kelas Studio
        </h1>
        <p style="font-size: 0.88rem; color: var(--text-muted); margin: 0;">
          Kelola kuota sesi studio, tarif berjenjang (member vs tamu), batas waktu pembatalan, dan jadwalkan sesi baru.
        </p>
      </div>

      <div style="display: grid; grid-template-columns: 1fr 360px; gap: 2rem; align-items: flex-start;">
        <!-- DAFTAR JADWAL KELAS -->
        <div>
          <h3 style="font-family: var(--font-display); font-size: 1.2rem; font-weight: 800; margin: 0 0 1rem; color: var(--text-main);">
            Daftar Jadwal Kelas Studio ({jadwalList.length})
          </h3>

          <div style="display: flex; flex-direction: column; gap: 1rem;">
            {jadwalList.map((j) => (
              <div class="surface-card" style="padding: 1.25rem 1.5rem;">
                <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem;">
                  <div>
                    <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 4px;">
                      <span class="pill-tag pill-tag--brass" style="font-size: 0.68rem;">
                        {j.tb_kategori_layanan.nama_kategori}
                      </span>
                      <span style="font-family: var(--font-mono); font-size: 0.72rem; color: var(--text-subtle);">
                        {j.tb_ruangan.nama_ruangan}
                      </span>
                    </div>

                    <h4 style="font-family: var(--font-display); font-size: 1.15rem; font-weight: 800; margin: 0 0 4px; color: var(--text-main);">
                      {j.judul_sesi}
                    </h4>

                    <div style="font-size: 0.82rem; color: var(--text-muted); margin-bottom: 8px;">
                      Instruktur: <strong>{j.tb_pengguna.nama_lengkap}</strong> • Waktu: {new Date(j.waktu_mulai).toLocaleDateString('id-ID', { weekday: 'short', day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' })}
                    </div>

                    <div style="display: flex; flex-wrap: wrap; gap: 12px; font-family: var(--font-mono); font-size: 0.78rem;">
                      <span>Member: <strong>Rp {Number(j.harga_member).toLocaleString('id-ID')}</strong></span>
                      <span>Tamu: <strong>Rp {Number(j.harga_non_member).toLocaleString('id-ID')}</strong></span>
                      <span>Batas Batal: <strong>{j.batas_batal_jam} Jam</strong></span>
                    </div>
                  </div>

                  <div style="text-align: right; flex-shrink: 0;">
                    <div class="pill-tag pill-tag--brass" style="font-size: 0.75rem; margin-bottom: 6px;">
                      {j.jumlah_terisi} / {j.kapasitas_maksimal} Kursi
                    </div>
                    <div>
                      <span class={`pill-tag ${j.status_sesi === 'terjadwal' ? 'pill-tag--green' : 'pill-tag--brass'}`} style="font-size: 0.68rem;">
                        {j.status_sesi.toUpperCase()}
                      </span>
                    </div>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- FORMULIR BUAT JADWAL BARU (DENGAN INPUT TERLINDUNGI OVERFLOW) -->
        <div class="surface-card" style="padding: 1.5rem; width: 100%; box-sizing: border-box;">
          <h3 style="font-family: var(--font-display); font-size: 1.15rem; font-weight: 800; margin: 0 0 1.25rem; color: var(--text-main); display: flex; align-items: center; gap: 8px;">
            <Icon name="calendar-check" size="1.2rem" />
            + Buat Jadwal Sesi Baru
          </h3>

          <form method="POST" action={actions.createJadwal} style="display: flex; flex-direction: column; gap: 1rem; width: 100%; box-sizing: border-box;">
            <div>
              <label for="judulSesi" style="display: block; font-size: 0.78rem; font-weight: 700; margin-bottom: 4px; color: var(--text-main);">
                Judul Sesi
              </label>
              <input
                type="text"
                id="judulSesi"
                name="judulSesi"
                required
                placeholder="Contoh: Yin Yoga & Breathwork"
                style="width: 100%; max-width: 100%; box-sizing: border-box; padding: 9px 12px; font-family: var(--font-body); font-size: 0.85rem; border: 1px solid var(--border-hairline); border-radius: var(--radius-sm); background: #FAF8F5;"
              />
            </div>

            <div>
              <label for="kategoriId" style="display: block; font-size: 0.78rem; font-weight: 700; margin-bottom: 4px; color: var(--text-main);">
                Kategori Layanan
              </label>
              <select
                id="kategoriId"
                name="kategoriId"
                required
                style="width: 100%; max-width: 100%; box-sizing: border-box; padding: 9px 12px; font-family: var(--font-body); font-size: 0.85rem; border: 1px solid var(--border-hairline); border-radius: var(--radius-sm); background: #FAF8F5;"
              >
                {kategoriList.map((k) => (
                  <option value={k.id}>{k.nama_kategori}</option>
                ))}
              </select>
            </div>

            <div>
              <label for="pelatihId" style="display: block; font-size: 0.78rem; font-weight: 700; margin-bottom: 4px; color: var(--text-main);">
                Pelatih / Trainer
              </label>
              <select
                id="pelatihId"
                name="pelatihId"
                required
                style="width: 100%; max-width: 100%; box-sizing: border-box; padding: 9px 12px; font-family: var(--font-body); font-size: 0.85rem; border: 1px solid var(--border-hairline); border-radius: var(--radius-sm); background: #FAF8F5;"
              >
                {pelatihList.map((p) => (
                  <option value={p.id}>{p.nama_lengkap}</option>
                ))}
              </select>
            </div>

            <div>
              <label for="ruanganId" style="display: block; font-size: 0.78rem; font-weight: 700; margin-bottom: 4px; color: var(--text-main);">
                Ruangan Studio
              </label>
              <select
                id="ruanganId"
                name="ruanganId"
                required
                style="width: 100%; max-width: 100%; box-sizing: border-box; padding: 9px 12px; font-family: var(--font-body); font-size: 0.85rem; border: 1px solid var(--border-hairline); border-radius: var(--radius-sm); background: #FAF8F5;"
              >
                {ruanganList.map((r) => (
                  <option value={r.id}>{r.nama_ruangan} (Maks: {r.kapasitas_maksimal})</option>
                ))}
              </select>
            </div>

            <!-- WAKTU MULAI & SELESAI DITATA VERTIKAL SUPAYA TIDAK OVERFLOW -->
            <div style="display: flex; flex-direction: column; gap: 0.85rem; width: 100%; box-sizing: border-box;">
              <div>
                <label for="waktuMulai" style="display: block; font-size: 0.78rem; font-weight: 700; margin-bottom: 4px; color: var(--text-main);">
                  Waktu Mulai Sesi
                </label>
                <input
                  type="datetime-local"
                  id="waktuMulai"
                  name="waktuMulai"
                  required
                  style="width: 100%; max-width: 100%; box-sizing: border-box; padding: 8px 10px; font-family: var(--font-body); font-size: 0.82rem; border: 1px solid var(--border-hairline); border-radius: var(--radius-sm); background: #FAF8F5;"
                />
              </div>
              <div>
                <label for="waktuSelesai" style="display: block; font-size: 0.78rem; font-weight: 700; margin-bottom: 4px; color: var(--text-main);">
                  Waktu Selesai Sesi
                </label>
                <input
                  type="datetime-local"
                  id="waktuSelesai"
                  name="waktuSelesai"
                  required
                  style="width: 100%; max-width: 100%; box-sizing: border-box; padding: 8px 10px; font-family: var(--font-body); font-size: 0.82rem; border: 1px solid var(--border-hairline); border-radius: var(--radius-sm); background: #FAF8F5;"
                />
              </div>
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 8px;">
              <div>
                <label for="kapasitasMaksimal" style="display: block; font-size: 0.75rem; font-weight: 700; margin-bottom: 4px; color: var(--text-main);">
                  Kuota Kursi
                </label>
                <input
                  type="number"
                  id="kapasitasMaksimal"
                  name="kapasitasMaksimal"
                  required
                  min="1"
                  max="50"
                  value="10"
                  style="width: 100%; max-width: 100%; box-sizing: border-box; padding: 8px 10px; font-family: var(--font-mono); font-size: 0.82rem; border: 1px solid var(--border-hairline); border-radius: var(--radius-sm); background: #FAF8F5;"
                />
              </div>
              <div>
                <label for="batasBatalJam" style="display: block; font-size: 0.75rem; font-weight: 700; margin-bottom: 4px; color: var(--text-main);">
                  Batas Batal (Jam)
                </label>
                <input
                  type="number"
                  id="batasBatalJam"
                  name="batasBatalJam"
                  required
                  min="0"
                  value="24"
                  style="width: 100%; max-width: 100%; box-sizing: border-box; padding: 8px 10px; font-family: var(--font-mono); font-size: 0.82rem; border: 1px solid var(--border-hairline); border-radius: var(--radius-sm); background: #FAF8F5;"
                />
              </div>
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 8px;">
              <div>
                <label for="hargaMember" style="display: block; font-size: 0.75rem; font-weight: 700; margin-bottom: 4px; color: var(--text-main);">
                  Harga Member
                </label>
                <input
                  type="number"
                  id="hargaMember"
                  name="hargaMember"
                  required
                  min="0"
                  value="75000"
                  style="width: 100%; max-width: 100%; box-sizing: border-box; padding: 8px 10px; font-family: var(--font-mono); font-size: 0.82rem; border: 1px solid var(--border-hairline); border-radius: var(--radius-sm); background: #FAF8F5;"
                />
              </div>
              <div>
                <label for="hargaNonMember" style="display: block; font-size: 0.75rem; font-weight: 700; margin-bottom: 4px; color: var(--text-main);">
                  Harga Tamu
                </label>
                <input
                  type="number"
                  id="hargaNonMember"
                  name="hargaNonMember"
                  required
                  min="0"
                  value="150000"
                  style="width: 100%; max-width: 100%; box-sizing: border-box; padding: 8px 10px; font-family: var(--font-mono); font-size: 0.82rem; border: 1px solid var(--border-hairline); border-radius: var(--radius-sm); background: #FAF8F5;"
                />
              </div>
            </div>

            <button type="submit" class="btn-primary" style="width: 100%; padding: 11px; margin-top: 6px; font-size: 0.88rem;">
              Simpan & Publikasikan Sesi
            </button>
          </form>
        </div>
      </div>
    </div>
  )}

  <!-- VIEW 3: RUANGAN & INVENTARIS LOKER -->
  {currentTab === 'ruangan' && (
    <div>
      <div style="margin-bottom: 2rem;">
        <div style="font-family: var(--font-mono); font-size: 0.72rem; color: var(--color-primary); font-weight: 800; letter-spacing: 0.1em; text-transform: uppercase;">
          STUDIO INVENTORY & PHYSICAL AMENITIES
        </div>
        <h1 style="font-family: var(--font-display); font-size: 1.85rem; font-weight: 800; color: var(--text-main); margin: 4px 0;">
          Master Ruangan & Inventaris Lemari Loker
        </h1>
        <p style="font-size: 0.88rem; color: var(--text-muted); margin: 0;">
          Monitoring status fisik lemari loker RFID (LK-01 s/d LK-10) serta master data studio.
        </p>
      </div>

      <!-- INVENTARIS LOKER RFID -->
      <div style="margin-bottom: 3rem;">
        <h3 style="font-family: var(--font-display); font-size: 1.25rem; font-weight: 800; margin: 0 0 1rem; color: var(--text-main); display: flex; align-items: center; gap: 8px;">
          <Icon name="lock-key" size="1.2rem" />
          Status Lemari Loker Pribadi (Dedicated RFID Lockers)
        </h3>

        <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 1rem;">
          {lokerList.map((l) => {
            const activeRent = l.tb_keanggotaan[0];
            const isUsed = l.status === 'digunakan' || !!activeRent;
            const isMaintenance = l.status === 'perawatan';
            return (
              <div class="surface-card" style="padding: 1.25rem;">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
                  <span style="font-family: var(--font-mono); font-size: 1.2rem; font-weight: 800; color: var(--color-primary);">
                    {l.nomor_loker}
                  </span>
                  <span
                    class={`pill-tag ${
                      isMaintenance ? 'pill-tag--brass' : isUsed ? 'pill-tag--green' : ''
                    }`}
                    style="font-size: 0.65rem;"
                  >
                    {isMaintenance ? 'PERAWATAN' : isUsed ? 'DIGUNAKAN MEMBER' : 'TERSEDIA'}
                  </span>
                </div>

                <div style="font-size: 0.78rem; color: var(--text-muted); margin-bottom: 12px;">
                  Lokasi: <strong>{l.lokasi_area}</strong>
                </div>

                {activeRent && (
                  <div style="background: #FFF; border: 1px solid var(--border-hairline); padding: 8px 10px; border-radius: var(--radius-sm); font-size: 0.72rem; margin-bottom: 10px;">
                    <div>Penyewa: <strong>{activeRent.tb_pengguna.nama_lengkap}</strong></div>
                    <div style="color: var(--text-subtle);">Berlaku s/d: {new Date(activeRent.tanggal_berakhir).toISOString().split('T')[0]}</div>
                  </div>
                )}

                {!activeRent && !isMaintenance && (
                  <div style="font-size: 0.72rem; color: var(--text-subtle); margin-bottom: 10px;">
                    Loker kosong, siap dialokasikan saat ada member baru mendaftar.
                  </div>
                )}

                <form method="POST" action={actions.updateStatusLoker}>
                  <input type="hidden" name="lokerId" value={l.id} />
                  <input
                    type="hidden"
                    name="status"
                    value={l.status === 'perawatan' ? 'tersedia' : 'perawatan'}
                  />
                  <button
                    type="submit"
                    class="btn-secondary"
                    style="width: 100%; padding: 6px; font-size: 0.75rem;"
                  >
                    {l.status === 'perawatan' ? 'Aktifkan Kembali' : 'Tandai Perawatan'}
                  </button>
                </form>
              </div>
            );
          })}
        </div>
      </div>

      <!-- MASTER RUANGAN & KATEGORI -->
      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 2rem;">
        <!-- MASTER RUANGAN -->
        <div class="surface-card" style="padding: 1.5rem;">
          <h4 style="font-family: var(--font-display); font-size: 1.15rem; font-weight: 800; margin: 0 0 1rem; color: var(--text-main); display: flex; align-items: center; gap: 8px;">
            <Icon name="door" size="1.2rem" />
            Ruangan Studio Fisik
          </h4>

          <div style="display: flex; flex-direction: column; gap: 10px; margin-bottom: 1.5rem;">
            {ruanganList.map((r) => (
              <div style="padding: 10px 12px; background: #FFF; border: 1px solid var(--border-hairline); border-radius: var(--radius-sm); display: flex; justify-content: space-between; align-items: center;">
                <div>
                  <div style="font-weight: 700; font-size: 0.88rem; color: var(--text-main);">{r.nama_ruangan}</div>
                  <div style="font-size: 0.75rem; color: var(--text-muted);">{r.lokasi}</div>
                </div>
                <span class="pill-tag pill-tag--brass" style="font-size: 0.68rem;">
                  Kapasitas: {r.kapasitas_maksimal} Orang
                </span>
              </div>
            ))}
          </div>

          <form method="POST" action={actions.createRuangan} style="display: flex; flex-direction: column; gap: 8px; border-top: 1px dashed var(--border-hairline); padding-top: 1rem;">
            <div style="font-size: 0.82rem; font-weight: 700; color: var(--text-main);">+ Tambah Ruangan Baru</div>
            <input type="text" name="nama" required placeholder="Nama Ruangan (misal: Studio Zen)" style="padding: 8px 12px; font-size: 0.82rem; border: 1px solid var(--border-hairline); border-radius: var(--radius-sm); background: #FAF8F5;" />
            <input type="text" name="lokasi" required placeholder="Lokasi (misal: Lantai 2 Sayap Barat)" style="padding: 8px 12px; font-size: 0.82rem; border: 1px solid var(--border-hairline); border-radius: var(--radius-sm); background: #FAF8F5;" />
            <input type="number" name="kapasitas" required min="1" max="100" value="10" placeholder="Kapasitas Maksimal" style="padding: 8px 12px; font-size: 0.82rem; border: 1px solid var(--border-hairline); border-radius: var(--radius-sm); background: #FAF8F5;" />
            <button type="submit" class="btn-primary" style="padding: 8px; font-size: 0.82rem; margin-top: 4px;">Simpan Ruangan</button>
          </form>
        </div>

        <!-- MASTER KATEGORI -->
        <div class="surface-card" style="padding: 1.5rem;">
          <h4 style="font-family: var(--font-display); font-size: 1.15rem; font-weight: 800; margin: 0 0 1rem; color: var(--text-main); display: flex; align-items: center; gap: 8px;">
            <Icon name="sparkle" size="1.2rem" />
            Kategori Layanan Studio
          </h4>

          <div style="display: flex; flex-direction: column; gap: 10px; margin-bottom: 1.5rem;">
            {kategoriList.map((k) => (
              <div style="padding: 10px 12px; background: #FFF; border: 1px solid var(--border-hairline); border-radius: var(--radius-sm); display: flex; justify-content: space-between; align-items: center;">
                <div>
                  <div style="font-weight: 700; font-size: 0.88rem; color: var(--text-main);">{k.nama_kategori}</div>
                  <div style="font-family: var(--font-mono); font-size: 0.72rem; color: var(--text-muted);">/{k.slug}</div>
                </div>
                <span class="pill-tag pill-tag--brass" style="font-size: 0.65rem;">
                  {k.ikon}
                </span>
              </div>
            ))}
          </div>

          <form method="POST" action={actions.createKategori} style="display: flex; flex-direction: column; gap: 8px; border-top: 1px dashed var(--border-hairline); padding-top: 1rem;">
            <div style="font-size: 0.82rem; font-weight: 700; color: var(--text-main);">+ Tambah Kategori Baru</div>
            <input type="text" name="nama" required placeholder="Nama Kategori (misal: Sound Bath Therapy)" style="padding: 8px 12px; font-size: 0.82rem; border: 1px solid var(--border-hairline); border-radius: var(--radius-sm); background: #FAF8F5;" />
            <input type="text" name="slug" required placeholder="Slug (misal: sound-bath)" style="padding: 8px 12px; font-size: 0.82rem; border: 1px solid var(--border-hairline); border-radius: var(--radius-sm); background: #FAF8F5;" />
            <input type="text" name="deskripsi" placeholder="Deskripsi Singkat" style="padding: 8px 12px; font-size: 0.82rem; border: 1px solid var(--border-hairline); border-radius: var(--radius-sm); background: #FAF8F5;" />
            <button type="submit" class="btn-primary" style="padding: 8px; font-size: 0.82rem; margin-top: 4px;">Simpan Kategori</button>
          </form>
        </div>
      </div>
    </div>
  )}

  <!-- VIEW 4: BUKU BESAR TRANSAKSI -->
  {currentTab === 'transaksi' && (
    <div>
      <div style="margin-bottom: 2rem;">
        <div style="font-family: var(--font-mono); font-size: 0.72rem; color: var(--color-primary); font-weight: 800; letter-spacing: 0.1em; text-transform: uppercase;">
          FINANCIAL AUDIT & MIDTRANS LEDGER
        </div>
        <h1 style="font-family: var(--font-display); font-size: 1.85rem; font-weight: 800; color: var(--text-main); margin: 4px 0;">
          Buku Besar Transaksi & Audit Gateway
        </h1>
        <p style="font-size: 0.88rem; color: var(--text-muted); margin: 0;">
          Rekapitulasi pembayaran gateway Midtrans Snap, histori settlement, dan audit transaksi pelanggan.
        </p>
      </div>

      <div class="surface-card" style="padding: 1.5rem; overflow-x: auto;">
        <table style="width: 100%; border-collapse: collapse; font-size: 0.85rem; text-align: left;">
          <thead>
            <tr style="border-bottom: 2px solid var(--border-hairline); font-family: var(--font-mono); font-size: 0.72rem; color: var(--text-subtle); text-transform: uppercase;">
              <th style="padding: 10px 14px;">Kode Pesanan</th>
              <th style="padding: 10px 14px;">Pelanggan</th>
              <th style="padding: 10px 14px;">Tipe</th>
              <th style="padding: 10px 14px;">Total Bayar</th>
              <th style="padding: 10px 14px;">Metode</th>
              <th style="padding: 10px 14px;">Status</th>
              <th style="padding: 10px 14px;">Waktu</th>
            </tr>
          </thead>
          <tbody>
            {rekapPesanan.map((p) => (
              <tr style="border-bottom: 1px solid var(--border-hairline);">
                <td style="padding: 12px 14px; font-family: var(--font-mono); font-weight: 700; color: var(--color-primary);">
                  {p.kode_pesanan}
                </td>
                <td style="padding: 12px 14px;">
                  <div style="font-weight: 700; color: var(--text-main);">
                    {p.tb_pengguna?.nama_lengkap || 'Pengguna'}
                  </div>
                  <div style="font-size: 0.75rem; color: var(--text-muted);">
                    {p.tb_pengguna?.email}
                  </div>
                </td>
                <td style="padding: 12px 14px; font-family: var(--font-mono); font-size: 0.78rem;">
                  {p.tipe_pesanan.toUpperCase()}
                </td>
                <td style="padding: 12px 14px; font-family: var(--font-mono); font-weight: 800; color: var(--text-main);">
                  Rp {Number(p.total_bayar).toLocaleString('id-ID')}
                </td>
                <td style="padding: 12px 14px; font-family: var(--font-mono); font-size: 0.78rem; color: var(--text-subtle);">
                  {p.metode_pembayaran ? p.metode_pembayaran.toUpperCase() : 'MIDTRANS'}
                </td>
                <td style="padding: 12px 14px;">
                  <span class={`pill-tag ${p.status_pembayaran === 'lunas' ? 'pill-tag--green' : 'pill-tag--brass'}`} style="font-size: 0.68rem;">
                    {p.status_pembayaran.toUpperCase()}
                  </span>
                </td>
                <td style="padding: 12px 14px; color: var(--text-subtle); font-size: 0.75rem;">
                  {new Date(p.waktu_dibuat).toLocaleString('id-ID', { dateStyle: 'short', timeStyle: 'short' })}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  )}

</DashboardLayout>
