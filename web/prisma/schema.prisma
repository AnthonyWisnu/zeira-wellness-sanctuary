/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model tb_pesanan {
  id                                                    String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kode_pesanan                                          String               @unique @db.VarChar(50)
  id_pelanggan                                          String               @db.Uuid
  tipe_pesanan                                          String               @db.VarChar(20)
  id_paket_membership                                   String?              @db.Uuid
  id_jadwal                                             String?              @db.Uuid
  total_bayar                                           Decimal              @db.Decimal(12, 2)
  metode_pembayaran                                     String?              @db.VarChar(50)
  snap_token                                            String?              @db.VarChar(255)
  snap_redirect_url                                     String?
  id_transaksi_gateway                                  String?              @db.VarChar(100)
  signature_key_terakhir                                String?              @db.VarChar(255)
  payload_gateway                                       Json?
  waktu_kedaluwarsa                                     DateTime?            @db.Timestamptz(6)
  bukti_transfer                                        String?              @db.VarChar(255)
  status_pembayaran                                     String               @default("menunggu_pembayaran") @db.VarChar(25)
  diverifikasi_oleh                                     String?              @db.Uuid
  waktu_verifikasi                                      DateTime?            @db.Timestamptz(6)
  catatan_verifikasi                                    String?
  waktu_dibuat                                          DateTime             @default(now()) @db.Timestamptz(6)
  waktu_diperbarui                                      DateTime             @default(now()) @db.Timestamptz(6)
  tb_pengguna_tb_pesanan_diverifikasi_olehTotb_pengguna tb_pengguna?         @relation("tb_pesanan_diverifikasi_olehTotb_pengguna", fields: [diverifikasi_oleh], references: [id], onUpdate: NoAction)
  tb_jadwal_sesi                                        tb_jadwal_sesi?      @relation(fields: [id_jadwal], references: [id], onUpdate: NoAction)
  tb_paket_membership                                   tb_paket_membership? @relation(fields: [id_paket_membership], references: [id], onUpdate: NoAction)
  tb_pengguna_tb_pesanan_id_pelangganTotb_pengguna      tb_pengguna          @relation("tb_pesanan_id_pelangganTotb_pengguna", fields: [id_pelanggan], references: [id], onDelete: Cascade, onUpdate: NoAction)
  tb_reservasi_sesi                                     tb_reservasi_sesi[]

  @@index([kode_pesanan], map: "idx_pesanan_kode")
  @@index([id_pelanggan], map: "idx_pesanan_pelanggan")
  @@index([status_pembayaran], map: "idx_pesanan_status")
}

