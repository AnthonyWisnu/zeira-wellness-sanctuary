generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model tb_jadwal_sesi {
  id                  String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  judul_sesi          String              @db.VarChar(150)
  id_kategori         String              @db.Uuid
  id_pelatih          String              @db.Uuid
  id_ruangan          String              @db.Uuid
  waktu_mulai         DateTime            @db.Timestamptz(6)
  waktu_selesai       DateTime            @db.Timestamptz(6)
  kapasitas_maksimal  Int
  jumlah_terisi       Int                 @default(0)
  harga_non_member    Decimal             @default(0) @db.Decimal(12, 2)
  harga_member        Decimal             @default(0) @db.Decimal(12, 2)
  batas_batal_jam     Int                 @default(24)
  status_sesi         String              @default("terjadwal") @db.VarChar(20)
  waktu_dibuat        DateTime            @default(now()) @db.Timestamptz(6)
  waktu_diperbarui    DateTime            @default(now()) @db.Timestamptz(6)
  tb_kategori_layanan tb_kategori_layanan @relation(fields: [id_kategori], references: [id], onUpdate: NoAction)
  tb_pengguna         tb_pengguna         @relation(fields: [id_pelatih], references: [id], onUpdate: NoAction)
  tb_ruangan          tb_ruangan          @relation(fields: [id_ruangan], references: [id], onUpdate: NoAction)
  tb_pesanan          tb_pesanan[]
  tb_reservasi_sesi   tb_reservasi_sesi[]

  @@index([id_pelatih], map: "idx_jadwal_pelatih")
  @@index([waktu_mulai, waktu_selesai], map: "idx_jadwal_rentang_waktu")
  @@index([id_ruangan], map: "idx_jadwal_ruangan")
  @@index([status_sesi], map: "idx_jadwal_status")
}

model tb_kategori_layanan {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nama_kategori    String           @unique @db.VarChar(100)
  slug             String           @unique @db.VarChar(100)
  deskripsi        String?
  ikon             String?          @db.VarChar(50)
  status_aktif     Boolean          @default(true)
  waktu_dibuat     DateTime         @default(now()) @db.Timestamptz(6)
  waktu_diperbarui DateTime         @default(now()) @db.Timestamptz(6)
  tb_jadwal_sesi   tb_jadwal_sesi[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model tb_keanggotaan {
  id                  String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  id_pelanggan        String              @db.Uuid
  id_paket_membership String              @db.Uuid
  id_loker            String?             @db.Uuid
  tanggal_mulai       DateTime            @db.Date
  tanggal_berakhir    DateTime            @db.Date
  status              String              @default("aktif") @db.VarChar(20)
  catatan             String?
  waktu_dibuat        DateTime            @default(now()) @db.Timestamptz(6)
  waktu_diperbarui    DateTime            @default(now()) @db.Timestamptz(6)
  tb_loker            tb_loker?           @relation(fields: [id_loker], references: [id], onUpdate: NoAction)
  tb_paket_membership tb_paket_membership @relation(fields: [id_paket_membership], references: [id], onUpdate: NoAction)
  tb_pengguna         tb_pengguna         @relation(fields: [id_pelanggan], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([id_pelanggan], map: "idx_keanggotaan_pelanggan")
  @@index([status], map: "idx_keanggotaan_status")
  @@index([tanggal_berakhir], map: "idx_keanggotaan_tanggal")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model tb_loker {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nomor_loker      String           @unique @db.VarChar(20)
  lokasi_area      String           @default("Locker Room Utama") @db.VarChar(50)
  status           String           @default("tersedia") @db.VarChar(20)
  catatan          String?
  waktu_dibuat     DateTime         @default(now()) @db.Timestamptz(6)
  waktu_diperbarui DateTime         @default(now()) @db.Timestamptz(6)
  tb_keanggotaan   tb_keanggotaan[]

  @@index([status], map: "idx_loker_status")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model tb_paket_membership {
  id                  String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nama_paket          String           @unique @db.VarChar(100)
  durasi_hari         Int
  harga               Decimal          @db.Decimal(12, 2)
  fasilitas_deskripsi String
  status_aktif        Boolean          @default(true)
  waktu_dibuat        DateTime         @default(now()) @db.Timestamptz(6)
  waktu_diperbarui    DateTime         @default(now()) @db.Timestamptz(6)
  tb_keanggotaan      tb_keanggotaan[]
  tb_pesanan          tb_pesanan[]
}

