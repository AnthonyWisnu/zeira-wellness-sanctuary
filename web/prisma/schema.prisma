  nomor_telepon                                                            String?             @db.VarChar(25)
  kata_sandi_hash                                                          String              @db.VarChar(255)
  peran                                                                    String              @default("pelanggan") @db.VarChar(20)
  status_aktif                                                             Boolean             @default(true)
  waktu_dibuat                                                             DateTime            @default(now()) @db.Timestamptz(6)
  waktu_diperbarui                                                         DateTime            @default(now()) @db.Timestamptz(6)
  tb_jadwal_sesi                                                           tb_jadwal_sesi[]
  tb_keanggotaan                                                           tb_keanggotaan[]
  tb_pesanan_tb_pesanan_diverifikasi_olehTotb_pengguna                     tb_pesanan[]        @relation("tb_pesanan_diverifikasi_olehTotb_pengguna")
  tb_pesanan_tb_pesanan_id_pelangganTotb_pengguna                          tb_pesanan[]        @relation("tb_pesanan_id_pelangganTotb_pengguna")
