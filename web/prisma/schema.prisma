  tb_reservasi_sesi_tb_reservasi_sesi_diabsen_oleh_pelatih_idTotb_pengguna tb_reservasi_sesi[] @relation("tb_reservasi_sesi_diabsen_oleh_pelatih_idTotb_pengguna")
  tb_reservasi_sesi_tb_reservasi_sesi_id_pelangganTotb_pengguna            tb_reservasi_sesi[] @relation("tb_reservasi_sesi_id_pelangganTotb_pengguna")

  @@index([email], map: "idx_pengguna_email")
  @@index([peran], map: "idx_pengguna_peran")
